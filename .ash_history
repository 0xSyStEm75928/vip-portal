# 2. トレンドJSON ＆ オールド退避統合エンジンの生成
cat << 'EOF' > core/stream_integrity_engine.py
import json, os, hashlib, time
MANIFEST_PATH     = "data_store/manifest.json"
STATE_PATH        = "data_store/active_state.json"
TREND_NDJSON_PATH = "data_store/stream_events.ndjson"
OLD_HISTORY_DIR   = "data_store/history_old"
def get_file_hash(filepath):
    if not os.path.exists(filepath): return None
    hasher = hashlib.sha256()
    with open(filepath, 'rb') as f:
        hasher.update(f.read())
    return hasher.hexdigest()[:12]
def main():
    now = time.time()
    iso_time = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(now))
    # 1. アクティブ状態の読み込み
    old_state = {}
    if os.path.exists(STATE_PATH):
        try: old_state = json.load(open(STATE_PATH, 'r', encoding='utf-8'))
        except: pass
    # オールド退避判定 (10回以上の更新、またはサイズ超過で history_old/ へバックアップ)
    cycle = old_state.get("cycle", 0) + 1
    if cycle % 10 == 0 and old_state:
        os.makedirs(OLD_HISTORY_DIR, exist_ok=True)
        old_filename = f"{OLD_HISTORY_DIR}/state_v1_cycle_{cycle}.json"
        json.dump(old_state, open(old_filename, 'w', encoding='utf-8'), indent=2, ensure_ascii=False)
    # 2. 最新アクティブ状態の構築
    current_hash = get_file_hash(__file__)
    new_state = {
        "timestamp": iso_time,
        "cycle": cycle,
        "engine_hash": current_hash,
        "status": "OPERATIONAL"
    }
    os.makedirs("data_store", exist_ok=True)
    json.dump(new_state, open(STATE_PATH, 'w', encoding='utf-8'), indent=2, ensure_ascii=False)
    # 3. ★【最先端トレンド】NDJSON (1行1JSON) ストリームへの爆速追記★
    trend_event = {
        "event_id": f"evt_{int(now*1000)}",
        "@timestamp": iso_time,
        "cycle": cycle,
        "hash_snapshot": current_hash,
        "action": "STREAM_PULSE"
    }
    with open(TREND_NDJSON_PATH, "a", encoding="utf-8") as ndf:
        ndf.write(json.dumps(trend_event, ensure_ascii=False) + "\n")
    print(f"SUCCESS|Cycle:{cycle}|TrendNDJSON:{TREND_NDJSON_PATH}|OldHistory:{OLD_HISTORY_DIR}")
if __name__ == "__main__":
    main()
EOF
