# dag_tap_engine.py （正当アルゴリズム実装版）
import json, sys, os, math
STATE_PATH = "json_core/tap_dag_state.json"
def load_state():
    if os.path.exists(STATE_PATH):
        try:
            return json.load(open(STATE_PATH, "r", encoding="utf-8"))
        except: pass
    return {"node": "N1_INGRESS", "raw_score": 0.0, "ema_val": 50.0, "sigmoid_prob": 0.50}
def save_state(data):
    os.makedirs("json_core", exist_ok=True)
    json.dump(data, open(STATE_PATH, "w", encoding="utf-8"), indent=2, ensure_ascii=False)
def main():
    state = load_state()
    flick = sys.argv[1].upper() if len(sys.argv) > 1 else "TOP"
    # 現在の生スコア
    x = state.get("raw_score", 0.0)
    prev_ema = state.get("ema_val", 50.0)
    # --- 1. 操作に応じた生パラメータの補正 ---
    if flick == "TOP":
        x += 1.5
    elif flick == "BOTTOM":
        x -= 1.5
    elif flick == "RIGHT":
        state["node"] = "N3_GATE" if state["node"] == "N1_INGRESS" else "N5_SUMMARY"
    elif flick == "LEFT":
        state["node"] = "N1_INGRESS" if state["node"] == "N3_GATE" else "N3_GATE"
    # --- 2. 正当アルゴリズム①: 指数移動平均 (EMA) による平滑化 ---
    # α (平滑化係数) = 0.3
    alpha = 0.3
    # 生のスコア推移を 0~100 スケールにマッピング
    raw_mapped = 50.0 + (x * 5.0)
    current_ema = (alpha * raw_mapped) + ((1.0 - alpha) * prev_ema)
    # --- 3. 正当アルゴリズム②: Sigmoid による確率/到達度のスコアリング ---
    # k=0.1 (ゲイン), x0=50.0 (変極点)
    sigmoid_val = 1.0 / (1.0 + math.exp(-0.1 * (current_ema - 50.0)))
    # 状態の更新（すべて数学的に安定した領域で収束）
    state["raw_score"] = round(x, 2)
    state["ema_val"] = round(current_ema, 2)
    state["sigmoid_prob"] = round(sigmoid_val, 4)
    state["status"] = "MATHEMATICALLY_VERIFIED"
    save_state(state)
    print(f"[REAL-ALGO TAP] Flick: {flick}")
    print(f"  ├─ Node        : {state['node']}")
    print(f"  ├─ Raw Score   : {state['raw_score']}")
    print(f"  ├─ EMA (平滑化) : {state['ema_val']}")
    print(f"  └─ Sigmoid(確率): {state['sigmoid_prob']} ({round(sigmoid_val*100, 1)}%)")
if __name__ == "__main__":
    main()
# dag_tap_engine.py (計算式整合性ガード版)
import json, sys, os, math
STATE_PATH = "json_core/tap_dag_state.json"
def load_state():
    if os.path.exists(STATE_PATH):
        try:
            return json.load(open(STATE_PATH, "r", encoding="utf-8"))
        except: pass
    return {"node": "N1_INGRESS", "raw_score": 0.0, "ema_val": 50.0, "sigmoid_prob": 0.50, "status": "INIT"}
def save_state(data):
    os.makedirs("json_core", exist_ok=True)
    json.dump(data, open(STATE_PATH, "w", encoding="utf-8"), indent=2, ensure_ascii=False)
def verify_formula(ema_val, sigmoid_prob):
    """
    【数学的整合性チェック】
    Sigmoid値 P は 1 / (1 + e^-0.1(EMA - 50)) で計算されているか？
    誤差 0.001 許容で数式の整合性を検証。
    """
    expected_p = 1.0 / (1.0 + math.exp(-0.1 * (ema_val - 50.0)))
    is_valid = math.isclose(sigmoid_prob, expected_p, abs_tol=1e-3)
    return is_valid, expected_p
def main():
    state = load_state()
    flick = sys.argv[1].upper() if len(sys.argv) > 1 else "TOP"
    x = state.get("raw_score", 0.0)
    prev_ema = state.get("ema_val", 50.0)
    # 1. 入力操作によるパラメータ変動
    if flick == "TOP":
        x += 1.0
    elif flick == "BOTTOM":
        x -= 1.0
    elif flick == "RIGHT":
        # 次のノードへ進むアクション
        state["intent_node"] = "N3_GATE"
    elif flick == "LEFT":
        state["intent_node"] = "N1_INGRESS"
    # 2. EMA（指数移動平均）計算
    alpha = 0.3
    raw_mapped = 50.0 + (x * 5.0)
    current_ema = (alpha * raw_mapped) + ((1.0 - alpha) * prev_ema)
    # 3. Sigmoid（確率変換）計算
    sigmoid_val = 1.0 / (1.0 + math.exp(-0.1 * (current_ema - 50.0)))
    # ★★★【絶対条件】数式整合性ガード（Formula Integrity Check）★★★
    is_valid, expected_p = verify_formula(current_ema, sigmoid_val)
    state["raw_score"] = round(x, 2)
    state["ema_val"] = round(current_ema, 2)
    state["sigmoid_prob"] = round(sigmoid_val, 4)
    if not is_valid:
        # 数式不一致！コード実行・ノード遷移を完全ロック
        state["status"] = "FORMULA_MISMATCH_LOCKED"
        save_state(state)
        print("FAIL|FORMULA_MISMATCH|echo '[LOCKED] 計算式が不完全・不一致です。コード実行を阻止しました。'")
        sys.exit(1)
    # 数式が完全に合致した場合のみ「完成（UNLOCK）」
    if "intent_node" in state:
        state["node"] = state.pop("intent_node")
    state["status"] = "FORMULA_VERIFIED_UNLOCKED"
    save_state(state)
    # 正常結果を出力（Bashへ渡す）
    cmd = f"jq . json_core/tap_dag_state.json"
    print(f"SUCCESS|{state['node']}|{cmd}")
if __name__ == "__main__":
    main()
# 1. 完全自作の計算式ガードエンジン (dag_tap_engine.py)
cat << 'EOF' > dag_tap_engine.py
import json, sys, os
STATE_PATH = "json_core/tap_dag_state.json"
def load_state():
    if os.path.exists(STATE_PATH):
        try:
            return json.load(open(STATE_PATH, "r", encoding="utf-8"))
        except: pass
    # 完全自作の初期パラメータ (A=20, B=10, C=20 -> 20*10/10 = 20 で完全一致)
    return {"node": "N1_INGRESS", "param_a": 20, "param_b": 10, "param_c": 20, "status": "INIT"}
def save_state(data):
    os.makedirs("json_core", exist_ok=True)
    json.dump(data, open(STATE_PATH, "w", encoding="utf-8"), indent=2, ensure_ascii=False)
def main():
    state = load_state()
    flick = sys.argv[1].upper() if len(sys.argv) > 1 else "TOP"
    a = state.get("param_a", 20)
    b = state.get("param_b", 10)
    # 1. 操作によるパラメータ変化（自作の変数動向）
    if flick == "TOP":
        a += 5
    elif flick == "BOTTOM":
        a -= 5
    elif flick == "RIGHT":
        b += 2
        state["node"] = "N3_GATE"
    elif flick == "LEFT":
        b -= 2
        state["node"] = "N1_INGRESS"
    # 2. 完全自作の計算式による C の自動算出
    # 式: C = (A * B) // 10
    c = (a * b) // 10
    # ★★★【完全自作の数学的整合性ガード】★★★
    # 条件1: A, B, C がすべて正の実数であること
    # 条件2: 総和 (A + B + C) が 500 を超えないこと
    total_sum = a + b + c
    
    if a <= 0 or b <= 0 or total_sum > 500:
        state["status"] = "CUSTOM_FORMULA_LOCKED"
        save_state(state)
        print("FAIL|FORMULA_ERROR|自作計算式の限界値制限(A,B>0 かつ Sum<=500)を超過しました。ロックします。")
        sys.exit(1)
    # 自作式の整合性が完全証明された（UNLOCK）
    state["param_a"] = a
    state["param_b"] = b
    state["param_c"] = c
    state["total_sum"] = total_sum
    state["status"] = "CUSTOM_ALGO_VERIFIED"
    save_state(state)
    print(f"SUCCESS|{state['node']}|jq . json_core/tap_dag_state.json")
if __name__ == "__main__":
    main()
