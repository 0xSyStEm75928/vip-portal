# 画面演出コードから抽出した汎用 ANSI 24bit カラーライブラリ
class Neon:
    RESET   = "\033[0m"
    MAGENTA = "\033[38;2;255;0;127m"  # #FF007F
    CYAN    = "\033[38;2;0;243;255m"  # #00F3FF
    YELLOW  = "\033[38;2;255;230;0m"  # #FFE600
    GREEN   = "\033[38;2;50;255;50m"   # #32FF32
    
    @staticmethod
    def wrap(text, color):
        return f"{color}{text}{Neon.RESET}"
EOF
# 3. 判定＆メトリクスエンジン（元バックエンドロジックの保存）
cat << 'EOF' > core/override_gate.py
import math, random
def calculate_impact(delta_ms, unk_x):
    speed_factor = round(1000.0 / max(1, delta_ms), 2)
    impact = round(speed_factor * unk_x, 4)
    sigmoid_p = round(1.0 / (1.0 + math.exp(-0.1 * (impact - 15.0))), 4)
    return impact, sigmoid_p
def evaluate_mode(delta_ms, unk_x, sigmoid_p, is_override=False):
    if is_override:
        return "FORCE_OVERRIDDEN", "N_REAL_OVERRIDE", 0.9999, 999.99
    if delta_ms < 150 and unk_x > 0.25 and sigmoid_p > 0.80:
        return "RARE_UNMASKED", "N_UNMASKED", unk_x, round((1000.0/delta_ms)*unk_x, 4)
    return "MASKED_STABLE", "N_MASKED", unk_x, round((1000.0/delta_ms)*unk_x, 4)
EOF
