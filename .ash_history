#!/bin/ash
set -eu
ROOT="${1:-./json_core}"
EVIDENCE="$ROOT/ZERO_CORE.audit_evidence.json"
CHAIN="$ROOT/ZERO_CORE.evidence_chain.json"
REPORT="$ROOT/ZERO_CORE.audit_report_v2.json"
