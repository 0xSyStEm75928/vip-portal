    else:
        failed.append(cmd[0])
print("=" * 72)
print("SUMMARY")
print("=" * 72)
print("SUCCESS :", success)
print("FAILED  :", len(failed))
if failed:
    print("")
    print("FAILED SCRIPTS")
    for item in failed:
        print("-", item)
print("")
print("FINISHED:",
      datetime.now(timezone.utc).isoformat())
sys.exit(
    1 if failed else 0
)
EOF
