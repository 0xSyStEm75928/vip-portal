    }
  ],
  "workflow":{
    "events":[
      "push",
      "pull_request",
      "schedule"
    ],
    "pipeline":[
      {
        "step":"collect",
        "action":"receive_scan_results"
      },
      {
        "step":"normalize",
        "action":"convert_to_zero_event"
      },
      {
