# 1. ベルフェゴール過激QA自動循環エンジン (belphegor_qa_loop.py)
cat << 'EOF' > belphegor_qa_loop.py
import json, sys, os, math, datetime
STATE_PATH = "json_core/belphegor_qa_state.json"
def load_state():
    if os.path.exists(STATE_PATH):
        try: return json.load(open(STATE_PATH, "r", encoding="utf-8"))
        except: pass
    return {
        "cycle_count": 0,
        "current_phase": "QUESTION",
        "radical_entropy": 0.85, # 過激度パラメータ (0.0 ~ 1.0)
        "last_qa_node": {}
    }
def save_state(data):
    os.makedirs("json_core", exist_ok=True)
    json.dump(data, open(STATE_PATH, "w", encoding="utf-8"), indent=2, ensure_ascii=False)
def generate_radical_qa(cycle, phase, entropy):
    """過激アルゴリズム理論に基づく自動質問・回答JSONの動的生成"""
    timestamp = datetime.datetime.now().isoformat()
    
    if phase == "QUESTION":
        # システム側から人間/DAGへ突きつける「鋭い自動質問」
        payload = {
            "type": "AUTO_QUESTION",
            "cycle": cycle,
            "timestamp": timestamp,
            "question_id": f"Q_BELPHEGOR_{cycle:03d}",
            "radical_score": round(entropy * 100, 1),
            "question_text": f"【周期 {cycle}】ボトルネックノード B_{cycle} の整合性を破綻させずに最大化するパラメータ解は存在するか？",
            "suggested_action": "ANSWER_GENERATION"
        }
        next_phase = "ANSWER"
    else:
        # 質問を即座に過激理論で打ち破る「自動仮説回答」
        # EMA/Sigmoid数理を背景に敷いた高密度解答
        confidence = 1.0 / (1.0 + math.exp(-0.2 * (entropy * 50 - 20)))
        payload = {
            "type": "AUTO_ANSWER",
            "cycle": cycle,
            "timestamp": timestamp,
            "answer_id": f"A_BELPHEGOR_{cycle:03d}",
            "confidence_level": round(confidence, 4),
            "hypothesis_answer": f"解法確立: ノード B_{cycle} の閾値を EMA(alpha=0.3) で平滑化し、Sigmoid確率 {round(confidence*100, 1)}% で強制突破を適用せよ。",
            "suggested_action": "NEXT_QUESTION"
        }
        next_phase = "QUESTION"
    return payload, next_phase
def main():
    state = load_state()
    cycle = state.get("cycle_count", 0) + 1
    phase = state.get("current_phase", "QUESTION")
    entropy = state.get("radical_entropy", 0.85)
    # 過激度スコアの動的ゆらぎ計算（過激アルゴリズム演算）
    new_entropy = min(0.99, max(0.50, entropy + (0.02 if phase == "QUESTION" else -0.01)))
    qa_payload, next_phase = generate_radical_qa(cycle, phase, new_entropy)
    state["cycle_count"] = cycle
    state["current_phase"] = next_phase
    state["radical_entropy"] = round(new_entropy, 4)
    state["last_qa_node"] = qa_payload
    save_state(state)
    # Bash出力用
    print(f"SUCCESS|{qa_payload['type']}|{cycle}|jq . json_core/belphegor_qa_state.json")
if __name__ == "__main__":
    main()
EOF
