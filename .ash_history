# 1/2: 404サイレント・プロテクト付きログサーバー/入力を処理するスクリプト
cat << 'EOF' > tools/devil_guard.py
import sys, json, re, time, os
BASE_DIR = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
SHARED_LOG_PATH = os.path.join(BASE_DIR, "data_store", "shared_stream.ndjson")
class DevilGuard:
    # 悪意あるパターン（HTML/JSインジェクション、コマンド実行など）
    MALICIOUS_PATTERNS = [
        r"<script.*?>", r"javascript:", r"eval\(", r"exec\(",
        r"system\(", r"__import__", r"../", r"<iframe"
    ]
    @classmethod
    def inspect_and_sanitize(cls, raw_user_input, user_id="anonymous"):
        # 1. 巨大入力（スパム）のガード (100文字制限)
        if not raw_user_input or len(raw_user_input) > 100:
            return cls.trigger_404_silent_kill("入力長オーバー")
        # 2. 危険なキーワード/パターンの検知
        for pattern in cls.MALICIOUS_PATTERNS:
            if re.search(pattern, raw_user_input, re.IGNORECASE):
                return cls.trigger_404_silent_kill(f"攻撃検知: {pattern}")
        # 3. 特殊文字のエスケープ（完全無害化）
        clean_text = (
            raw_user_input.replace("&", "&amp;")
            .replace("<", "&lt;")
            .replace(">", "&gt;")
            .replace('"', "&quot;")
            .replace("'", "&#x27;")
            .strip()
        )
        return clean_text
    @staticmethod
    def trigger_404_silent_kill(reason):
        print(f"\033[1;31m[404 NOT FOUND]\033[0m 契約違反検知: {reason} ➔ 存在を隠蔽してサイレント破棄")
        # Webサーバー連携時はここで HTTP 404 Status Code を返して接続を切る
        return None
def write_shared_log(user_input, user_id="anon"):
    clean_msg = DevilGuard.inspect_and_sanitize(user_input, user_id)
    
    if clean_msg is None:
        # 404弾き発生（ログに書かずに終了）
        return False
    now = time.time()
    event = {
        "id": f"msg_{int(now*1000)}",
        "timestamp": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(now)),
        "user": user_id,
        "message": clean_msg
    }
    os.makedirs(os.path.dirname(SHARED_LOG_PATH), exist_ok=True)
    with open(SHARED_LOG_PATH, "a", encoding="utf-8") as f:
        f.write(json.dumps(event, ensure_ascii=False) + "\n")
    print(f"\033[1;32m[LOG ACCEPTED]\033[0m 安全なログとして契約承認: \"{clean_msg}\"")
    return True
if __name__ == "__main__":
    test_input = sys.argv[1] if len(sys.argv) > 1 else "Hello World!"
    write_shared_log(test_input)
EOF
# 2/2: 滑らかスクロール＆暗黒ネオンのログビューワー作成
cat << 'EOF' > tools/viewer.html
<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <title>SHARED STREAM LOGS // DEVIL GUARD</title>
  <style>
    body {
      background-color: #0b0e14;
      color: #00f3ff;
      font-family: 'Courier New', Courier, monospace;
      margin: 0;
      padding: 0;
      overflow-x: hidden;
    }
    /* 空白スクロール空間（無限スクロールの演出） */
    .scroll-space {
      height: 120vh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      text-align: center;
    }
    .hint {
      color: #ff007f;
      font-size: 0.9rem;
      letter-spacing: 2px;
      animation: pulse 2s infinite;
    }
    @keyframes pulse {
      0% { opacity: 0.3; }
      50% { opacity: 1; }
      100% { opacity: 0.3; }
    }
    /* ログの滑らかスクロールコンテナ */
    .stream-container {
      max-width: 800px;
      margin: 0 auto 200px auto;
      padding: 20px;
      background: rgba(15, 20, 30, 0.8);
      border: 1px solid #00f3ff;
      border-radius: 8px;
      box-shadow: 0 0 20px rgba(0, 243, 255, 0.2);
    }
    .log-item {
      padding: 12px;
      border-bottom: 1px solid rgba(0, 243, 255, 0.1);
      transition: all 0.3s ease;
      opacity: 0;
      transform: translateY(20px);
      animation: slideIn 0.5s forwards ease-out;
    }
    @keyframes slideIn {
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
    .log-time { color: #ff007f; margin-right: 10px; }
    .log-user { color: #ffe600; font-weight: bold; margin-right: 10px; }
    .log-msg  { color: #ffffff; }
  </style>
</head>
<body>
  <!-- スクロールを誘導する広大な余白空間 -->
  <div class="scroll-space">
    <h1>/// STREAM LOG ARCHIVE ///</h1>
    <p class="hint">▼ SCROLL DOWN TO REVEAL SHARED LOGS ▼</p>
  </div>
  <!-- 滑らかに表示されるログ本体 -->
  <div class="stream-container" id="logContainer">
    <div style="color: #00f3ff; text-align: center; margin-bottom: 15px;">[ DEVIL GUARD ACTIVE // 404 PROTECTED ]</div>
    <!-- ログがここに滑らかに挿入される -->
  </div>
</body>
</html>
EOF
