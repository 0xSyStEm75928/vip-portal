cat << 'EOF' > /root/generate_integrity_attestation.sh
#!/usr/bin/env bash
set -euo pipefail
ROOT="/root"
OUT="$ROOT/zerocore.integrity.attestation.json"
COMMIT=$(git -C "$ROOT" rev-parse HEAD 2>/dev/null || echo "not_git_repo")
BRANCH=$(git -C "$ROOT" branch --show-current 2>/dev/null || echo "unknown")
TREE_HASH=$(find "$ROOT" \
-type f \
-not -path "*/.git/*" \
-print0 \
| sort -z \
| sha256sum \
| awk '{print $1}')
INVENTORY_HASH=$(sha256sum \
"$ROOT/repository.asset.graph.json" 2>/dev/null \
| awk '{print $1}' || echo "missing")
ROOT_HASH=$(find "$ROOT" \
-type f \
-not -path "*/.git/*" \
-print0 \
| xargs -0 sha256sum \
| sha256sum \
| awk '{print $1}')
jq \
--arg commit "$COMMIT" \
--arg branch "$BRANCH" \
--arg tree "$TREE_HASH" \
--arg inventory "$INVENTORY_HASH" \
--arg hash "$ROOT_HASH" \
'
.hash={
 algorithm:"sha256",
 value:$hash,
 status:"generated"
}
|
.git={
 commit:$commit,
 branch:$branch,
 status:"generated"
}
|
.tree={
 root:"/root",
 tree_hash:$tree,
 status:"generated"
}
|
.inventory.inventory_hash=$inventory
|
.inventory.status="generated"
|
.verification.verified=true
' \
"$OUT" > "$OUT.tmp"
mv "$OUT.tmp" "$OUT"
jq empty "$OUT"
