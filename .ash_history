cat << 'EOF' > /root/verify_json_registry.sh
#!/usr/bin/env bash
set -euo pipefail
ROOT="${1:-/root}"
RESULT="$ROOT/json.verification.result.json"
echo "[*] JSON Registry Verification"
TOTAL=0
PASS=0
FAIL=0
TMP=$(mktemp)
find "$ROOT" \
  -type f \
  -name "*.json" \
  2>/dev/null \
  > "$TMP"
jq -n \
--arg root "$ROOT" \
'
{
  "json_verification":{
    "root":$root,
    "status":"running"
  },
  "files":[]
}
' > "$RESULT"
while IFS= read -r file
do
  TOTAL=$((TOTAL+1))
  if jq empty "$file" >/dev/null 2>&1
  then
    STATUS="valid"
    PASS=$((PASS+1))
  else
    STATUS="invalid"
    FAIL=$((FAIL+1))
  fi
  jq \
  --arg path "$file" \
  --arg status "$STATUS" \
  '.files += [{
      "path":$path,
      "status":$status
    }]' \
  "$RESULT" > "$RESULT.tmp"
  mv "$RESULT.tmp" "$RESULT"
done < "$TMP"
rm -f "$TMP"
jq \
--argjson total "$TOTAL" \
--argjson pass "$PASS" \
--argjson fail "$FAIL" \
'
.verification_summary={
  "total":$total,
  "valid":$pass,
  "invalid":$fail
}
|
.verification_status=
(
 if $fail==0
 then "PASSED"
 else "REVIEW_REQUIRED"
 end
)
' "$RESULT" > "$RESULT.tmp"
mv "$RESULT.tmp" "$RESULT"
echo
echo "[✓] Completed"
echo "Total : $TOTAL"
echo "Valid : $PASS"
echo "Invalid : $FAIL"
echo
echo "Output:"
echo "$RESULT"
jq '.verification_summary,.verification_status' "$RESULT"
EOF
chmod +x /root/verify_json_registry.sh
/root/verify_json_registry.sh /root
