cat << 'EOF' > /root/generate_git_state_attestation.sh
#!/usr/bin/env bash
set -euo pipefail
ROOT="/root"
OUT="$ROOT/zerocore.git.state.attestation.json"
BRANCH=$(git -C "$ROOT" branch --show-current 2>/dev/null || echo "unknown")
HEAD=$(git -C "$ROOT" rev-parse HEAD 2>/dev/null || echo "unknown")
REMOTE=$(git -C "$ROOT" remote -v 2>/dev/null | awk '{print $1" "$2}' | jq -R -s 'split("\n")|map(select(length>0))')
STATUS=$(git -C "$ROOT" status --porcelain 2>/dev/null | jq -R -s 'split("\n")|map(select(length>0))')
LOG=$(git -C "$ROOT" log --oneline -20 2>/dev/null | jq -R -s 'split("\n")|map(select(length>0))')
jq \
--arg branch "$BRANCH" \
--arg head "$HEAD" \
--argjson remote "$REMOTE" \
--argjson status "$STATUS" \
--argjson log "$LOG" \
--arg time "$(date -u +"%Y-%m-%dT%H:%M:%SZ")" \
'
.repository.branch=$branch
|
.repository.head_commit=$head
|
.repository.remote=$remote
|
.working_tree.status=$status
|
.history.latest_commits=$log
|
.history.commit_count=($log|length)
|
.integrity.generated_at=$time
|
.verification.git_available=true
|
.verification.state_captured=true
' \
"$OUT" > "$OUT.tmp"
mv "$OUT.tmp" "$OUT"
jq empty "$OUT"
echo "[✓] Git state attestation generated"
EOF
