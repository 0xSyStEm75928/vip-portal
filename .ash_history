cat <<'EOF' >> business_opportunity.registry.js
,
  "opportunity_pipeline": {
    "stages": [
      {
        "id": "signal_detected",
        "description": "Public or internal signal discovered",
        "next": "qualified"
      },
      {
        "id": "qualified",
        "description": "Opportunity satisfies validation rules",
        "required": [
          "source",
          "scope",
          "estimated_value"
        ],
        "next": "analysis"
      },
      {
        "id": "analysis",
        "description": "Technical and business feasibility analysis",
        "next": "proposal_ready"
      },
      {
        "id": "proposal_ready",
        "description": "Ready for external communication",
        "next": "negotiation"
      },
      {
        "id": "negotiation",
        "description": "External discussion phase",
        "next": "contracted"
      },
      {
        "id": "contracted",
        "description": "Confirmed service engagement",
        "next": "delivery"
      },
      {
        "id": "delivery",
        "description": "Execution and evidence collection",
        "next": "completed"
      },
      {
        "id": "completed",
        "description": "Archived result with evidence"
      }
    ]
  },
  "opportunity_record_schema": {
    "id": null,
    "identity": {
      "organization": null,
      "contact_reference": null,
      "verification": false
    },
    "signal": {
      "source": null,
      "source_type": [
        "github_issue",
        "gitcoin",
        "research_request",
        "direct_contact",
        "market_signal"
      ],
      "detected_at": null
    },
    "technical_scope": {
      "domain": null,
      "stack": [],
      "problem_statement": null,
      "expected_output": null
    },
    "business": {
      "estimated_budget": null,
      "currency": null,
      "priority": "unknown",
      "repeat_probability": 0
    },
    "evaluation": {
      "score": 0,
      "confidence": 0,
      "decision": "pending"
    },
    "evidence_chain": {
      "inputs": [],
      "analysis_records": [],
      "outputs": [],
      "hash_chain": []
    },
    "lifecycle": {
      "stage": "signal_detected",
      "updated_at": null
    }
  },
  "scoring_engine": {
    "version": "1.0.0",
    "formula": {
      "technical_match": "0-35",
      "scope_clarity": "0-25",
      "client_history": "0-20",
      "repeat_value": "0-10",
      "urgency": "0-10"
    },
    "thresholds": {
      "ignore": "<40",
      "review": "40-69",
      "priority": "70+"
    }
  },
  "proposal_generator": {
    "enabled": true,
    "input": [
      "opportunity_record",
      "evidence_records",
      "score_result"
    ],
    "output": {
      "format": [
        "markdown",
        "json"
      ],
      "sections": [
        "problem",
        "observed_evidence",
        "technical_assessment",
        "recommended_action",
        "estimated_effort"
      ]
    }
  },
  "client_memory": {
    "enabled": true,
    "stored_metrics": [
      "previous_requests",
      "response_time",
      "payment_history",
      "technical_alignment"
    ],
    "privacy_guard": {
      "store_only_business_relevant_data": true,
      "no_sensitive_information": true
    }
  },
  "automation_hooks": {
    "jssh": {
      "listen": [
        "command_observation",
        "analysis_complete",
        "report_generated"
      ]
    },
    "sun_kernel": {
      "event_bus": "SunEvent",
      "compatible": true
    }
  },
  "audit": {
    "immutable_log": true,
    "fields": [
      "event_id",
      "timestamp",
      "actor",
      "action",
      "before_hash",
      "after_hash"
    ]
  }
}
