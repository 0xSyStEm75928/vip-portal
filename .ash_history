cat <<'EOF' > saac.disclosure.control.registry.json
{
  "$schema": "./schemas/saac.disclosure.control.registry.schema.json",
  "name": "SaaC Disclosure Control Registry",
  "version": "1.0.0",
  "purpose": "Manage disclosure state between private architecture assets and public presentation layers",
  "meta": {
    "engine": "SaaC DeviL Kernel",
    "layer": "L4_DISCLOSURE_ZONE",
    "architecture": "CUI_FIRST",
    "principle": "Control disclosure. Preserve evidence."
  },
  "disclosure_modes": {
    "SECRET": {
      "level": 0,
      "description": "Internal only assets",
      "access": [
        "kernel",
        "owner"
      ],
      "export": false
    },
    "PRIVATE": {
      "level": 1,
      "description": "Trusted review environment",
      "access": [
        "owner",
        "authorized_reviewer"
      ],
      "export": false
    },
    "CONTROLLED": {
      "level": 2,
      "description": "Limited business disclosure",
      "access": [
        "client",
        "partner"
      ],
      "export": true
    },
    "PUBLIC": {
      "level": 3,
      "description": "External presentation layer",
      "access": [
        "public"
      ],
      "export": true
    }
  },
  "toggle": {
    "enabled": true,
    "current_mode": "PRIVATE",
    "transition": {
      "allowed": [
        {
          "from": "SECRET",
          "to": "PRIVATE"
        },
        {
          "from": "PRIVATE",
          "to": "CONTROLLED"
        },
        {
          "from": "CONTROLLED",
          "to": "PUBLIC"
        }
      ],
      "requires_confirmation": true
    }
  },
  "asset_policy": {
    "classification_required": true,
    "default_classification": "PRIVATE",
    "protected_assets": [
      "master.meta.json",
      "master.authority.json",
      "master.security.policy.json",
      "evidence.chain.json",
      "jssh.kernel.json"
    ],
    "public_candidates": [
      "service.catalog",
      "business.profile",
      "demo.package",
      "documentation"
    ]
  },
  "integration": {
    "system_manifest": "saac.system.manifest.json",
    "json_registry": "saac.json.registry.json",
    "enterprise_registry": "saac.enterprise.registry.json",
    "audit": "saac.audit.report.json"
  },
  "history": [],
  "state": {
    "status": "disclosure_control_ready",
    "zone": "L4"
  }
}
EOF
