# 2. 完全確定ロジック（場所・キー補正付き）の書き込み
cat << 'EOF' > sync_pipeline.py
import json, os, sys
BASE_DIR = "json_core"
FILES = {
    "customer": os.path.join(BASE_DIR, "core_customer_master.json"),
    "intake": os.path.join(BASE_DIR, "ingress_customer_intake.json"),
    "gate": os.path.join(BASE_DIR, "gate_lifecycle_control.json"),
    "plan": os.path.join(BASE_DIR, "dispatch_daily_schedule.json"),
    "queue": os.path.join(BASE_DIR, "review_human_approval_queue.json"),
    "action": os.path.join(BASE_DIR, "dispatch_next_action_queue.json"),
    "sync_summary": os.path.join(BASE_DIR, "view_deal_sync_summary.json")
}
def load_j(p):
    return json.load(open(p, "r", encoding="utf-8")) if os.path.exists(p) else {}
def save_j(p, d):
    os.makedirs(os.path.dirname(p), exist_ok=True)
    json.dump(d, open(p, "w", encoding="utf-8"), indent=2, ensure_ascii=False)
def sync_all_nodes(target_id, status, channel="DIRECT_CONTACT"):
    ts = "2026-07-29T19:50:00+09:00"
    # --- 1. Master (Dict/List 両対応で正解の位置に配置) ---
    c = load_j(FILES["customer"])
    custs = c.get("customers", {})
    if isinstance(custs, dict):
        custs[target_id] = {"customer_id": target_id, "status": status, "updated_at": ts, "payment_state": "VERIFIED"}
        c["customers"] = custs
    elif isinstance(custs, list):
        found = False
        for item in custs:
            if isinstance(item, dict) and item.get("customer_id") == target_id:
                item.update({"status": status, "updated_at": ts, "payment_state": "VERIFIED"})
                found = True
                break
        if not found:
            custs.append({"customer_id": target_id, "status": status, "updated_at": ts, "payment_state": "VERIFIED"})
        c["customers"] = custs
    c["updated_at"] = ts
    save_j(FILES["customer"], c)
    # --- 2. Intake ---
    i = load_j(FILES["intake"])
    i["customer"] = {"customer_id": target_id, "last_contact_at": ts, "status": status, "channel": channel}
    i["updated_at"] = ts
    save_j(FILES["intake"], i)
    # --- 3. Gate (制御解除・検証完了) ---
    g = load_j(FILES["gate"])
    g["current_customer"] = {"customer_id": target_id, "verified": True, "updated_at": ts}
    g["updated_at"] = ts
    save_j(FILES["gate"], g)
    # --- 4. Action Queue (最終確定ノードへの絶対反映) ---
    act = load_j(FILES["action"])
    actions = act.get("tomorrow_actions", [])
    action_found = False
    for item in actions:
        if isinstance(item, dict) and item.get("customer_id") == target_id:
            item.update({
                "current_status": status,
                "payment_state": "VERIFIED",
                "recommended_action": "CONTRACT_FINALIZATION",
                "execution_locked": True
            })
            action_found = True
            break
    if not action_found:
        actions.append({
            "customer_id": target_id,
            "current_status": status,
            "priority": "A",
            "recommended_action": "CONTRACT_FINALIZATION",
            "payment_state": "VERIFIED",
            "execution_locked": True
        })
    act["tomorrow_actions"] = actions
    act["updated_at"] = ts
    act["execution_status"] = "VERIFIED_AND_ACTION_LOCKED"
    save_j(FILES["action"], act)
    print(f"[SUCCESS] LOCKED & CONFIRMED: {target_id} -> Status: {status}")
if __name__ == "__main__":
    cid = sys.argv[1] if len(sys.argv) > 1 else "CUSTOMER_001"
    st = sys.argv[2] if len(sys.argv) > 2 else "VERIFICATION"
    ch = sys.argv[3] if len(sys.argv) > 3 else "DIRECT"
    sync_all_nodes(cid, st, ch)
EOF
