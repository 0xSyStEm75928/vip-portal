python3 -c '
path = "customer_deal_sync_check.py"
with open(path, "r", encoding="utf-8") as f:
    code = f.read()
# find_customer 関数を Dict/List 両対応に安全に置換
old_fn = """def find_customer(customer, cid):
    if c.get("customer_id") == cid:"""
new_fn = """def find_customer(customers, cid):
    if isinstance(customers, dict):
        if cid in customers:
            val = customers[cid]
            return val if isinstance(val, dict) else {"customer_id": cid}
        for k, v in customers.items():
            if isinstance(v, dict) and v.get("customer_id") == cid:
                return v
    elif isinstance(customers, list):
        for c in customers:
            if isinstance(c, dict) and c.get("customer_id") == cid:
                return c
    return None"""
import re
# 柔軟に find_customer 関数の定義部分を置換
code = re.sub(r"def find_customer\([\s\S]*?:", new_fn.split("\n")[0], code, count=1)
with open(path, "w", encoding="utf-8") as f:
    f.write(code)
'
# 正確なロジックでの全置換ワンライナー
cat << 'EOF' > patch_sync.py
with open("customer_deal_sync_check.py", "r", encoding="utf-8") as f:
    lines = f.readlines()
new_lines = []
in_fn = False
for line in lines:
    if line.startswith("def find_customer"):
        in_fn = True
        new_lines.append("def find_customer(customers, cid):\n")
        new_lines.append("    if isinstance(customers, dict):\n")
        new_lines.append("        if cid in customers:\n")
        new_lines.append("            val = customers[cid]\n")
        new_lines.append("            return val if isinstance(val, dict) else {'customer_id': cid}\n")
        new_lines.append("        for k, v in customers.items():\n")
        new_lines.append("            if isinstance(v, dict) and v.get('customer_id') == cid:\n")
        new_lines.append("                return v\n")
        new_lines.append("    elif isinstance(customers, list):\n")
        new_lines.append("        for c in customers:\n")
        new_lines.append("            if isinstance(c, dict) and c.get('customer_id') == cid:\n")
        new_lines.append("                return c\n")
        new_lines.append("    return None\n")
    elif in_fn:
        if line.startswith("def ") or (line.strip() and not line.startswith(" ") and not line.startswith("\t")):
            in_fn = False
            new_lines.append(line)
    else:
        new_lines.append(line)
with open("customer_deal_sync_check.py", "w", encoding="utf-8") as f:
    f.writelines(new_lines)
EOF
