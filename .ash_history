cat << 'EOF' > sync_pipeline.py
import json, sys, os
from datetime import datetime, timezone, timedelta
JST = timezone(timedelta(hours=9))
NOW_JST = "2026-07-29T18:13:00+09:00"
LOG_FILE = "storage/logs/append_only_ingress.jsonl"
REGISTRY_FILE = "json_core/cli_contact_evidence_registry.json"
GATE_FILE = "json_core/customer_lifecycle_gate.json"
CORE_FILE = "json_core/ZERO_CORE.customer.json"
def emit_event(target_id, channel, raw_cmd, evidence_type="CONTRACT_DIRECT"):
    # 1. 追記型JSONLログへ直接ライト（iOSストレージ高速化）
    record = {
        "timestamp": NOW_JST,
        "target_id": target_id,
        "channel": channel,
        "payload": {"command_raw": raw_cmd, "type": evidence_type}
    }
    with open(LOG_FILE, "a", encoding="utf-8") as f:
        f.write(json.dumps(record, ensure_ascii=False) + "\n")
    
    # 2. INGRESS レジストリへ同期
    reg = json.load(open(REGISTRY_FILE))
    reg["updated_at"] = NOW_JST
    reg["records"].append(record)
    json.dump(reg, open(REGISTRY_FILE, "w", encoding="utf-8"), indent=2, ensure_ascii=False)
    # 3. GATE & PERSISTENCE コアステートへ一括反映
    core = json.load(open(CORE_FILE))
    core["updated_at"] = NOW_JST
    core["customers"][target_id] = {
        "status": "VERIFIED_INGRESS",
        "last_evidence": record,
        "updated_at": NOW_JST
    }
    json.dump(core, open(CORE_FILE, "w", encoding="utf-8"), indent=2, ensure_ascii=False)
    
    print(f"[HYBRID SYNC COMPLETE] -> Logged to JSONL & Synced to DAG JSONs (Target: {target_id})")
if __name__ == "__main__":
    if len(sys.argv) > 1:
        emit_event(sys.argv[1], "CLI_DIRECT", " ".join(sys.argv[2:]))
    else:
        # 初期導通テスト
        emit_event("TARGET_INIT_001", "CLI_INIT", "SYSTEM_HYBRID_ANCHOR_ACTIVE")
EOF
# 5. 初期動作確認テストの実行
