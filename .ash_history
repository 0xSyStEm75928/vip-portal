    "formats": [
      "JSON",
      "Markdown",
      "Archive"
    ]
  },
  "governance": {
    "rules": [
      "deliver_observation_before_conclusion",
      "preserve_audit_trace",
      "require_scope_confirmation"
    ]
  },
  "state": {
    "status": "delivery_definition_ready"
  }
}
EOF
