# 1. JSON-s ストリームを駆動する超軽量エンジン関数
jssh_stream() {
    # 引数からJSONを受け取る（なければ初期JSON）
    local input_json='{"node":"N_001","stream_id":"STR_999","payload":{"val":10,"status":"ACTIVE"}}'
    if [ -n "$1" ]; then input_json="$1"; fi
    # PythonでJSONをリアルタイム演算 & 次のノード付きJSONへ進化させる
    local res=$(python3 -c "
import json, sys, math
data = json.loads('''$input_json''')
node = data.get('node', 'N_001')
val = data['payload']['val']
# ストリーム演算（例：数値を1.5倍し、Sigmoid確率を付与）
next_val = round(val * 1.5, 2)
prob = round(1.0 / (1.0 + math.exp(-0.05 * next_val)), 4)
# 次のノード判定
curr_num = int(node.split('_')[1])
next_node = f'N_{curr_num + 1:03d}'
next_json = {
    'node': next_node,
    'stream_id': data['stream_id'],
    'payload': {'val': next_val, 'prob': prob, 'status': 'STREAMING'}
}
# 1行圧縮JSONにして親シェルへ返却
print(json.dumps(next_json, ensure_ascii=False))
")
    # 画面にストリーム表示
    echo -e "\033[1;36m[STREAM-NODE]\033[0m \033[1;33m$res\033[0m"
    # ★★★ 最強の仕掛け：演算結果のJSONを丸ごと組み込んだコマンドを history -s に直接インジェクション！ ★★★
    # エスケープ処理をして次の一手を完璧にセット
    local escaped_json=$(echo "$res" | sed 's/"/\\"/g')
    history -s "jssh_stream \"$escaped_json\""
    echo -e "\033[1;32m>>> [JSON -s INJECTED] 次のストリームノードを history -s に送り込みました！\033[0m"
    echo -e "\033[1;32m>>> 『↑』 (上矢印) キーを押して Enter を連打してください！\033[0m"
}
# 2. ストリーム起動！
jssh_stream
