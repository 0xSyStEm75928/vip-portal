      "example": [
        "[REGISTRY]",
        "     |",
        "     v",
        "[EVENT]",
        "     |",
        "     v",
        "[EVIDENCE]"
      ]
    },
    "history": {
      "example": [
        "v1.0.0",
        " |",
        " v",
        "v1.1.0",
        " |",
        " v",
        "v1.2.0"
      ]
    }
  },
  "commands": {
    "generate_tree": "sun tree --json",
    "generate_circuit": "sun circuit --json",
    "generate_history": "sun history --ascii"
  },
  "security": {
    "read_only": true,
    "no_source_mutation": true,
    "requires_registry_permission": true
  },
  "evidence": {
    "visual_generation_log": true,
    "record": [
      "input_registry_hash",
      "renderer_version",
      "timestamp",
      "output_hash"
    ]
  },
  "history": [
    {
      "event": "visual_circuit_layer_created",
      "version": "1.0.0"
    }
  ],
  "state": {
    "status": "visual_layer_ready"
  }
}
