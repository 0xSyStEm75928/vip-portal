cat <<'EOF' > saac.lifecycle.manager.json
{
  "$schema": "./schemas/saac.lifecycle.manager.schema.json",
  "name": "SaaC Lifecycle Manager",
  "version": "1.0.0",
  "purpose": "Manage service lifecycle and state transitions for CUI based operations",
  "lifecycle": {
    "states": [
      {
        "id": "created",
        "description": "Service request created",
        "next": [
          "scoping"
        ]
      },
      {
        "id": "scoping",
        "description": "Define objective, scope and requirements",
        "next": [
          "approved",
          "rejected"
        ]
      },
      {
        "id": "approved",
        "description": "Execution authorized",
        "next": [
          "processing"
        ]
      },
      {
        "id": "processing",
        "description": "Analysis and evidence generation in progress",
        "next": [
          "review",
          "blocked"
        ]
      },
      {
        "id": "review",
        "description": "Result review and confirmation phase",
        "next": [
          "completed",
          "revision"
        ]
      },
      {
        "id": "revision",
        "description": "Additional adjustment requested",
        "next": [
          "processing",
          "completed"
        ]
      },
      {
        "id": "completed",
        "description": "Delivery completed and archived",
        "next": [
          "maintenance"
        ]
      },
      {
        "id": "maintenance",
        "description": "Continuous improvement or support phase",
        "next": [
          "completed"
        ]
      },
      {
        "id": "blocked",
        "description": "Execution paused due to missing condition",
        "next": [
          "processing",
          "cancelled"
        ]
      },
      {
        "id": "rejected",
        "description": "Request declined",
        "next": []
      },
      {
        "id": "cancelled",
        "description": "Service terminated",
        "next": []
      }
    ]
  },
  "transition_rules": {
    "required": [
      "state_change_record",
      "timestamp",
      "reason",
      "actor"
    ]
  },
  "integration": {
    "contract": "saac.contract.profile.json",
    "dashboard": "saac.operation.dashboard.json",
    "audit": "saac.audit.report.json",
    "event_source": "sun.event.v1.json"
  },
  "governance": {
    "rules": [
      "no_hidden_state_transition",
      "record_all_changes",
      "preserve_history"
    ]
  },
  "state": {
    "status": "lifecycle_definition_ready"
  }
}
EOF
