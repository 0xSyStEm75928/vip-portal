cat << 'EOF' > zerocore_runtime.py
import json
import hashlib
from datetime import datetime
def run_zerocore():
    print("=== ZeroCore Runtime Initiating ===")
    
    # 1. Boot Load (Layer 0)
    with open("Layer0_Boot/boot_record.json", "r") as f:
        boot_record = json.load(f)
    print(f"[Layer 0] Loaded Boot Record: {boot_record['boot_id']}")
    
    # 2. Capability Check (Layer 3)
    with open("Layer3_Registry/capability_registry.json", "r") as f:
        cap_reg = json.load(f)
    print("[Layer 3] Validating Capability Registry...")
    
    # 3. Process Initial Sequence
    for seq in boot_record["initial_sequence"]:
        if seq["action"] == "EXEC_SYSCALL":
            syscall = seq["syscall"]
            payload = seq["payload"]
            cap_used = payload.get("capability_used")
            
            # 権限評価 (Layer 3)
            cap_info = cap_reg["capabilities"].get(cap_used, {})
            if syscall in cap_info.get("allowed_syscalls", []):
                print(f"[Layer 2] Syscall Executed: {syscall} (Capability Verified: {cap_used})")
                
                # 監査ログ更新 (Layer 4)
                commit_audit(payload["event_type"], payload["actor"])
            else:
                print(f"[SECURITY ALERT] Syscall Blocked: {syscall} - Invalid Capability!")
def commit_audit(event_type, actor):
    audit_file = "Layer4_Audit/audit_chain.json"
    with open(audit_file, "r") as f:
        audit_chain = json.load(f)
        
    records = audit_chain["records"]
    last_record = records[-1]
    
    # ハッシュ計算 (簡易版)
    new_seq = last_record["sequence"] + 1
    timestamp = datetime.utcnow().strftime("%Y-%m-%dT%H:%M:%SZ")
    prev_hash = last_record["state_hash"]
    
    hash_payload = f"{new_seq}{timestamp}{event_type}{actor}{prev_hash}".encode('utf-8')
    new_hash = hashlib.sha256(hash_payload).hexdigest()
    
    new_entry = {
        "sequence": new_seq,
        "timestamp": timestamp,
        "event_id": f"evt_run_{new_seq:03d}",
        "event_type": event_type,
        "actor": actor,
        "capability_verified": True,
        "state_hash": new_hash,
        "prev_hash": prev_hash,
        "status": "COMMITTED"
    }
    
    records.append(new_entry)
    audit_chain["total_records"] = len(records)
    
    with open(audit_file, "w") as f:
        json.dump(audit_chain, f, indent=2)
        
    print(f"[Layer 4] Audit Committed! Sequence: #{new_seq} | Hash: {new_hash[:12]}...")
if __name__ == "__main__":
    run_zerocore()
EOF
