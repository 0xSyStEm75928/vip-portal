-type f \
-name "*.json" \
-not -path "/root/.config/*"
cat << 'EOF' > /root/verify_security_registry_only.sh
#!/usr/bin/env bash
set -euo pipefail
ROOT="${1:-/root}"
RESULT="$ROOT/security.registry.verify.result.json"
TMP=$(mktemp)
find "$ROOT" \
-type f \
\( \
-name "*registry.json" -o \
-name "*manifest.json" -o \
-name "*schema.json" -o \
-name "*controller.json" -o \
-name "*verification*.json" -o \
-name "*audit.json" -o \
-name "*evidence*.json" -o \
-name "*graph.json" \
\) \
2>/dev/null \
> "$TMP"
jq -n \
--arg root "$ROOT" \
--slurpfile files "$TMP" '
{
 "security_registry_verification":{
   "root":$root,
   "files_scanned":($files[0]|length)
 },
 "results":[]
}
' > "$RESULT"
while IFS= read -r file
do
 if jq empty "$file" >/dev/null 2>&1
 then
   status="valid"
 else
   status="invalid"
 fi
 jq \
 --arg path "$file" \
 --arg status "$status" \
 '.results += [{
   "file":$path,
   "status":$status
 }]' \
 "$RESULT" > "$RESULT.tmp"
 mv "$RESULT.tmp" "$RESULT"
done < "$TMP"
rm -f "$TMP"
jq '
.results
| group_by(.status)
| map({
    status:.[0].status,
    count:length
  })
' "$RESULT"
echo "[✓] Output:"
echo "$RESULT"
EOF
chmod +x /root/verify_security_registry_only.sh
/root/verify_security_registry_only.sh /root
