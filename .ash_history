  "visual_engine": {
    "id": "VIS-001",
    "name": "JSON Circuit Renderer",
    "mode": "CUI_FIRST",
    "layouts": [
      "tree",
      "flow",
      "dependency_graph",
      "history_trace"
    ]
  },
  "mapping_rules": {
    "node": {
      "id": "registry.id",
      "label": "title",
      "type": "category"
    },
    "connection": {
      "source": "depends_on",
      "target": "id",
      "relation": "next"
    },
    "state_view": {
      "active": "[ACTIVE]",
      "pending": "[PENDING]",
      "error": "[ERROR]"
    }
  },
  "ascii_template": {
    "node": [
      "+----------------+",
      "| {id}           |",
      "| {type}         |",
      "| {status}       |",
      "+-------+--------+"
    ],
    "connector": [
      "|",
      "v"
    ]
  },
  "registry_binding": {
    "primary": "saac.json.registry.json",
    "supported": [
      "saac.enterprise.registry.json",
      "saac.system.manifest.json",
      "saac.flow.registry.json",
      "saac.history.registry.json"
