{
  "$schema": "./schemas/zerocore.github.validation.contract.schema.json",
  "meta": {
    "name": "zerocore.github.validation.contract",
    "version": "1.1.0",
    "purpose": "deterministic_repository_verification"
  },
  "repository": {
    "required_files": [
      "zerocore.sovereign.bootstrap.v1.json",
      "schemas/zerocore.sovereign.bootstrap.schema.json",
      "Validator/zerocore_validate.sh"
    ],
    "required_directories": [
      ".github/workflows",
      "Evidence",
      "Validator",
      "schemas"
    ]
  },
  "pipeline": {
    "trigger": {
      "events": [
        "push",
        "pull_request"
      ],
      "branches": [
        "main"
      ]
    },
    "validation_chain": [
      {
        "id": "json_integrity",
        "tool": "jq",
        "required": true
      },
      {
        "id": "schema_validation",
        "tool": "jsonschema",
        "required": true
      },
      {
        "id": "runtime_validation",
        "tool": "Validator/zerocore_validate.sh",
        "required": true
      },
      {
        "id": "evidence_generation",
        "tool": "sha256",
        "required": true
      }
    ]
  },
  "anti_false_positive": {
    "require_execution": true,
    "forbidden_states": [
      "manual_success",
      "static_success",
      "declaration_only"
    ],
    "proof_requirements": {
      "command_output_required": true,
      "artifact_required": true,
      "timestamp_required": true
    }
  },
  "security": {
    "github_native": {
      "codeql": {
        "required": true
      },
      "dependabot": {
        "required": true
      },
      "secret_scanning": {
        "required": true
      }
    }
  },
  "evidence": {
    "format": "jsonl",
    "output": "Evidence/github-actions.audit.jsonl",
    "include": [
      "commit_sha",
      "workflow_run",
      "timestamp",
      "validation_result"
    ]
  },
  "final_state": {
    "allowed": [
      "VERIFIED",
      "FAILED"
    ],
    "default": "FAILED"
  }
}
EOF
