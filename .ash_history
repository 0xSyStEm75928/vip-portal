cat << 'EOF' > Validator/zerocore_validate.sh
#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
MANIFEST="${ROOT}/zerocore.sovereign.bootstrap.v1.json"
AUDIT="${ROOT}/Evidence/audit/audit.log.jsonl"
echo "=== ZeroCore Bootstrap Verification ==="
timestamp=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
check () {
    NAME="$1"
    CMD="$2"
    if eval "$CMD"; then
        echo "{\"time\":\"$timestamp\",\"check\":\"$NAME\",\"status\":\"PASS\"}" >> "$AUDIT"
        echo "[PASS] $NAME"
    else
        echo "{\"time\":\"$timestamp\",\"check\":\"$NAME\",\"status\":\"FAIL\"}" >> "$AUDIT"
        echo "[FAIL] $NAME"
        exit 1
    fi
}
check "manifest_exists" \
"test -f $MANIFEST"
check "json_integrity" \
"jq empty $MANIFEST"
check "registry_architecture" \
"jq -e '.architecture.model==\"Registry First Architecture\"' $MANIFEST >/dev/null"
check "evidence_enabled" \
"jq -e '.evidence_chain.enabled==true' $MANIFEST >/dev/null"
check "runtime_portable" \
"jq -e '.runtime.environment.jailbreak_required==false' $MANIFEST >/dev/null"
check "validator_policy" \
"jq -e '.verification.execution_rule.all_required_validators_pass==true' $MANIFEST >/dev/null"
echo "=============================="
echo "ZeroCore Bootstrap VERIFIED"
echo "Evidence:"
echo "$AUDIT"
EOF
