    if "current_customer" in g and isinstance(g["current_customer"], dict):
        g["current_customer"].update({"customer_id": target_id, "updated_at": ts, "verified": status in ["VERIFIED", "CONTRACTED"], "blocked_actions": blocked})
    else:
        g["current_customer"] = {"customer_id": target_id, "updated_at": ts, "verified": status in ["VERIFIED", "CONTRACTED"], "blocked_actions": blocked}
    save_j(FILES["gate"], g)
    # 4. Schedule Plan
    p = load_j(FILES["plan"])
    acts = p.setdefault("priority", [])
    for act in acts:
        if act.get("target") == target_id or act.get("customer_id") == target_id:
            act.update({"status": status, "updated_at": ts})
            break
    else:
        acts.append({"target": target_id, "priority": "A", "objective": f"Action for {status}", "status": status, "updated_at": ts})
    save_j(FILES["plan"], p)
    # 5. Review Queue
    q = load_j(FILES["queue"])
    q_list = q.setdefault("queue", [])
    for item in q_list:
        if item.get("customer_id") == target_id or item.get("target") == target_id:
            item.update({"requires_human_approval": status != "CONTRACTED", "current_status": status, "updated_at": ts})
            break
    else:
        q_list.append({"target_id": target_id, "requires_human_approval": status != "CONTRACTED", "current_status": status, "updated_at": ts})
    save_j(FILES["queue"], q)
    print(f"[OK] BUNDLE REGISTERED & SYNCED FOR: {target_id} ({status})")
if __name__ == "__main__":
    if len(sys.argv) < 3:
        sys.exit(1)
    sync(sys.argv[1], sys.argv[2], sys.argv[3] if len(sys.argv) > 3 else "DIRECT")
