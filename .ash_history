cat <<'EOF' > saac.disclosure.control.json
{
  "$schema": "./schemas/saac.disclosure.control.schema.json",
  "name": "SaaC Disclosure Control",
  "version": "1.0.0",
  "purpose": "Control disclosure boundaries between secret core assets and external projections",
  "architecture": {
    "model": "layered_disclosure",
    "principle": "Core remains protected. Projection exposes verified information."
  },
  "disclosure_modes": {
    "SECRET": {
      "level": 0,
      "access": "owner_only",
      "description": "Full internal assets, runtime logic, security configuration"
    },
    "PRIVATE": {
      "level": 1,
      "access": "trusted_party",
      "description": "Limited disclosure under controlled relationship"
    },
    "PUBLIC": {
      "level": 2,
      "access": "general",
      "description": "Public documentation and verified overview"
    }
  },
  "control_rules": [
    "default_secret",
    "explicit_release_required",
    "evidence_before_claim",
    "schema_validation_required",
    "history_append_only",
    "no_internal_runtime_exposure"
  ],
  "asset_boundary": {
    "protected": [
      "runtime_configuration",
      "security_policy",
      "internal_evidence",
      "private_history",
      "core_registry"
    ],
    "releasable": [
      "architecture_summary",
      "public_schema",
      "demo_package",
      "verified_documentation"
    ]
  },
  "projection": {
    "enabled": true,
    "source": [
      "saac.system.manifest.json",
      "saac.enterprise.registry.json",
      "saac.identity.registry.json"
    ],
    "targets": {
      "public": "saac.identity.public.json",
      "client": "saac.client.package.json"
    }
  },
  "authorization": {
    "release_required": true,
    "approval": {
      "method": "manual",
      "evidence_required": true
    }
  },
  "history": [
    {
      "event": "disclosure_control_created",
      "version": "1.0.0"
    }
  ],
  "state": {
    "status": "disclosure_control_ready",
    "default_mode": "SECRET"
  }
}
EOF
cat <<'EOF' > saac.runtime.compiler.manifest.json
{
  "$schema": "./schemas/saac.runtime.compiler.manifest.schema.json",
  "name": "SaaC Runtime Compiler Manifest",
  "version": "1.0.0",
  "purpose": "Define deterministic compilation from JSON source of truth into runtime optimized execution state",
  "architecture": {
    "model": "JSON_SOURCE_TO_RUNTIME_COMPILE",
    "principle": "JSON remains immutable source of truth. Runtime artifacts are generated outputs."
  },
  "source_layer": {
    "format": "JSON",
    "role": "declarative_control_plane",
    "inputs": [
      "saac.system.manifest.json",
      "saac.enterprise.registry.json",
      "saac.json.registry.json",
      "saac.flow.registry.json",
      "saac.disclosure.control.json"
    ]
  },
  "validation_pipeline": {
    "required": true,
    "checks": [
      "schema_validation",
      "dependency_validation",
      "contract_validation",
      "policy_validation",
      "evidence_binding"
    ]
  },
  "compiler": {
    "mode": "deterministic",
    "stages": [
      {
        "id": "CMP-001",
        "name": "parse",
        "input": "json",
        "output": "normalized_state"
      },
      {
        "id": "CMP-002",
        "name": "validate",
        "input": "normalized_state",
        "output": "validated_state"
      },
      {
        "id": "CMP-003",
        "name": "optimize",
        "input": "validated_state",
        "output": "runtime_state"
      },
      {
        "id": "CMP-004",
        "name": "compile",
        "input": "runtime_state",
        "output": "binary_runtime_artifact"
      }
    ]
  },
  "runtime_targets": {
    "primary": ".saac_devil_runtime",
    "formats": [
      {
        "name": "bson",
        "purpose": "structured_runtime_cache"
      },
      {
        "name": "flatbuffers",
        "purpose": "low_latency_execution_state"
      },
      {
        "name": "msgpack",
        "purpose": "portable_runtime_exchange"
      }
    ]
  },
  "state_management": {
    "source_of_truth": "json",
    "generated_state": {
      "immutable": false,
      "rebuildable": true
    },
    "version_binding": {
      "required": true,
      "method": "semantic_version"
    }
  },
  "performance": {
    "optimization_targets": [
      "memory_loading",
      "fast_lookup",
      "reduced_parse_cost",
      "runtime_cache"
    ],
    "hot_path": {
      "enabled": true,
      "source": "compiled_state"
    }
  },
  "evidence": {
    "compile_record": true,
    "records": [
      "input_hash",
      "schema_version",
      "compiler_version",
      "output_hash",
      "timestamp"
    ]
  },
  "security": {
    "rules": [
      "no_runtime_mutation_of_source",
      "compile_after_validation_only",
      "evidence_required_for_state_change"
    ]
  },
  "integration": {
    "registry": "saac.json.registry.json",
    "audit": "saac.audit.report.json",
    "evidence": "evidence.chain.json"
  },
  "history": [
    {
      "event": "runtime_compiler_manifest_created",
      "version": "1.0.0"
    }
  ],
  "state": {
    "status": "runtime_compiler_ready"
  }
}
EOF
