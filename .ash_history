./saac.registry.inspect.sh
cat <<'EOF' > saac.flow.registry.json
{
  "$schema": "./schemas/saac.flow.registry.schema.json",
  "name": "SaaC Flow Registry",
  "version": "1.0.0",
  "purpose": "Define module communication and evidence driven workflow",
  "flow_engine": {
    "mode": "event_driven",
    "source": "SunEvent",
    "validation_required": true
  },
  "pipelines": [
    {
      "id": "technical_review_flow",
      "trigger": {
        "event": "jssh.command_observation"
      },
      "steps": [
        {
          "module": "jssh.kernel.json",
          "action": "capture_event"
        },
        {
          "module": "sun.event.v1.json",
          "action": "normalize_event"
        },
        {
          "module": "evidence.chain.json",
          "action": "create_evidence_record"
        },
        {
          "module": "business_opportunity.registry.final.json",
          "action": "evaluate_opportunity"
        }
      ],
      "output": [
        "evidence_record",
        "analysis_result",
        "business_decision"
      ]
    },
    {
      "id": "external_offer_flow",
      "trigger": {
        "event": "external_request_received"
      },
      "steps": [
        {
          "module": "zerocore.external.offer.registry.json",
          "action": "register_offer"
        },
        {
          "module": "external.review.package.json",
          "action": "prepare_review"
        },
        {
          "module": "zerocore.evidence.package.json",
          "action": "attach_evidence"
        },
        {
          "module": "zerocore.service.offer.json",
          "action": "generate_service_response"
        }
      ],
      "output": [
        "review_package",
        "service_proposal"
      ]
    },
    {
      "id": "financial_validation_flow",
      "trigger": {
        "event": "financial_analysis_request"
      },
      "steps": [
        {
          "module": "financial.discovery.v3.json",
          "action": "collect_signal"
        },
        {
          "module": "financial.evidence.reader.json",
          "action": "validate_information"
        },
        {
          "module": "financial.reality.validation.json",
          "action": "produce_result"
        }
      ],
      "output": [
        "financial_evidence",
        "validation_result"
      ]
    }
  ],
  "response_contract": {
    "format": "SaaC_FLOW_RESPONSE",
    "required": [
      "event_id",
      "input",
      "processed_modules",
      "evidence",
      "result",
      "next_action"
    ]
  },
  "governance": {
    "rules": [
      "no_unverified_claim",
      "require_evidence_before_output",
      "preserve_event_trace"
    ],
    "audit_link": "saac_event.log.json"
  },
  "state": {
    "status": "architecture_review",
    "flows_registered": 3
  }
}
EOF
jq empty saac.flow.registry.json && echo OK
cat <<'EOF' > saac.response.schema.json
{
  "$schema": "./schemas/saac.response.schema.json",
  "name": "SaaC Response Contract",
  "version": "1.0.0",
  "purpose": "Standard response format for evidence driven CUI operations",
