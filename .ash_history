cat << 'EOF' > .github/workflows/zerocore-validation.yml
name: ZeroCore Validation
on:
  push:
    branches:
      - main
  pull_request:
jobs:
  zerocore-audit:
    runs-on: ubuntu-latest
    steps:
    - name: Checkout
      uses: actions/checkout@v4
    - name: Install jq
      run: |
        sudo apt-get update
        sudo apt-get install -y jq
    - name: JSON Integrity Check
      run: |
        jq empty zerocore.sovereign.bootstrap.v1.json
    - name: Schema Presence Check
      run: |
        test -f schemas/zerocore.sovereign.bootstrap.schema.json
    - name: ZeroCore Validator
      run: |
        chmod +x Validator/zerocore_validate.sh
        ./Validator/zerocore_validate.sh
    - name: Upload Evidence
      uses: actions/upload-artifact@v4
      with:
        name: zerocore-evidence
        path: Evidence/
EOF
