import sys, time, os, math, json
# ANSI ネオンカラー定義
C_RESET   = "\033[0m"
C_MAGENTA = "\033[38;2;255;0;127m"  # ネオンマゼンタ
C_CYAN    = "\033[38;2;0;243;255m"  # ネオンシアン
C_GREEN   = "\033[38;2;50;255;50m"   # ネオングリーン
C_BG_DARK = "\033[48;2;10;10;25m"   # 深夜のサイバーダーク背景
def draw_cyber_tunnel():
    # 最新ログの読み込み
    state_file = "json_core/kbd_x_belphegor_state.json"
    log_info = "NO_DATA"
    if os.path.exists(state_file):
        try:
            d = json.load(open(state_file, "r"))
            log_info = f"CYCLE:{d.get('cycle')} | X:{d.get('unk_x')} | IMPACT:{d.get('multiplied_impact')} | MODE:{d.get('ai_mode')}"
        except: pass
    # 画面クリア＆カーソル非表示
    os.system("clear")
    print("\033[?25l", end="")
    # トンネル描画アニメーション (パースの効いたネオン棒線)
    for frame in range(8):
        os.system("clear")
        print(f"{C_BG_DARK}")
        print(f"{C_CYAN}════════════════════════════════════════════════════════════════════════════════{C_RESET}")
        print(f"{C_MAGENTA} ⚡ [CYBERPUNK LOG-STREAM TUNNEL v2.0] ⚡  <64-BIT NEON ENGINE>{C_RESET}")
        print(f"{C_CYAN}════════════════════════════════════════════════════════════════════════════════{C_RESET}\n")
        # トンネルの奥行き計算 (リングの収縮アニメーション)
        shift = (frame % 4)
        
        # 1. 巨大入り口ゲート (手前ネオン)
        print(f"   {C_MAGENTA}╔══════════════════════════════════════════════════════════════════╗{C_RESET}")
        print(f"   {C_MAGENTA}║  {C_CYAN}▲ ENTRANCE GATE (CYBERPUNK PORTAL) ▲{C_MAGENTA}                            ║{C_RESET}")
        
        # 2. 中層トンネル (動く光線棒線)
        for depth in range(1, 5):
            pad = " " * (depth * 3)
            w = 58 - (depth * 6)
            line_char = "═" if (depth + shift) % 2 == 0 else "─"
            color = C_CYAN if depth % 2 == 0 else C_MAGENTA
            
            if depth == 2:
                # ログのコアノードを手前～中層に表示
                print(f"   {pad}{color}┌{line_char*w}┐{C_RESET}")
                print(f"   {pad}{color}│ {C_GREEN}★ DATA-NODE: {log_info[:w-16]} {color}│{C_RESET}")
                print(f"   {pad}{color}└{line_char*w}┘{C_RESET}")
            else:
                print(f"   {pad}{color}┌{line_char*w}┐{C_RESET}")
                print(f"   {pad}{color}└{line_char*w}┘{C_RESET}")
        # 3. 奥の収縮点 (消失点)
        print(f"               {C_GREEN}││  ░▒▓█ [DEEP SYSTEM CORE] █▓▒░  ││{C_RESET}")
        print(f"               {C_GREEN}▼▼                                ▼▼{C_RESET}\n")
        print(f"{C_CYAN}────────────────────────────────────────────────────────────────────────────────{C_RESET}")
        print(f"{C_MAGENTA} >>> [history -s] 次のノードへ向かう光速ラインが装填されました...{C_RESET}")
        time.sleep(0.04) # 爆速アニメーション
    print("\033[?25h", end="") # カーソル復元
if __name__ == "__main__":
    draw_cyber_tunnel()
