"node": "CUSTOMER_FLOW_001"  ──> "CUSTOMER_FLOW_002"
# 【アイデア例2】 AIパラメータ・プロンプト連鎖（Auto-Prompting）
"node": "PROMPT_CHAIN_STAGE_1" ──> "PROMPT_CHAIN_STAGE_2"
# 【アイデア例3】 境界値・検疫ストリーム（Quarantine Stream）
"node": "EDGE_DATA_CHECK_N1" ──> "EDGE_DATA_CHECK_N2"
# Gitで管理するコード側（ロジックは不変・固定）
# 実行時の「タイトル／カテゴリ」だけを外から注入して history -s に流す！
jssh_stream_custom() {
    local category_title="${1:-BELPHEGOR_STREAM}"  # タイトル・ネーミングを自在に注入
    local initial_val="${2:-100}"
    local json_payload=$(cat <<EOF
{
  "category": "$category_title",
  "node_id": "${category_title}_001",
  "payload": { "value": $initial_val, "status": "INITIALIZED" }
}
EOF
    )
    # 演算後にネーミングを引き継いで history -s にインジェクション！
    history -s "jssh_stream_custom '$category_title' $((initial_val + 50))"
    echo -e "\033[1;32m>>> [カテゴリ: $category_title] の次ノードを history -s に固定！\033[0m"
}
jssh_stream_custom "CUSTOMER_FLOW" 100
jssh_stream_custom "PROMPT_CHAIN" 500
jssh_stream_custom "CUSTOMER_TRAFFIC" 100
jssh_stream_custom "PROMPT_CHAIN" 500
jssh_stream_custom "BELPHEGOR_QUARANTINE" 999
