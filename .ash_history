git reset HEAD . 2>/dev/null || true
# 2. 今回作成された新規ファイル・ディレクトリをすべて削除
rm -f zerocore.pipeline.json
rm -f zerocore.sovereign.bootstrap.v1.json
rm -rf schemas Validator Evidence .github/workflows/zerocore.yml
