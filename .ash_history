    echo ""
    echo -e "\033[1;33m>>> 【注入成功】あなたの手元の history -s に次の一手を送り込みました！\033[0m"
    echo -e "\033[1;33m>>> 今すぐキーボードの 『↑』 (上矢印) を押してみてください。\033[0m"
}
# 2. テスト実行
jssh_test
# 「履歴への取り込み」と「次の進行」を一体化させた一発プロシージャ
jssh_step() {
    local target="${1:-CUSTOMER_001}"
    local current_step="${2:-STEP_1_INIT}"
    echo -e "\033[1;36m[LOCKING NODE]\033[0m 現在の操作 『$current_step』 を履歴コンテキストに完全固定中..."
    
    # 1. 状態を履歴（JSON）にしっかり取り込んで固定する
    python3 -c "
import json, os
p = 'json_core/context_history.json'
os.makedirs('json_core', exist_ok=True)
data = {'last_locked_step': '$current_step', 'target': '$target', 'status': 'COMMITTED'}
json.dump(data, open(p, 'w', encoding='utf-8'), indent=2)
"
    echo -e "\033[1;32m[COMMITTED]\033[0m 履歴に取り込み完了！先へのルートが開きました。"
    echo "--------------------------------------------------------"
    # 2. 履歴に取り込まれたからこそ、次の一手が『history -s』に巻き起こる
    if [ "$current_step" = "STEP_1_INIT" ]; then
        history -s "jssh_step $target STEP_2_SYNC"
        echo -e "\033[1;33m>>> 次のノード 『jssh_step $target STEP_2_SYNC』 を手元に準備しました。\033[0m"
    elif [ "$current_step" = "STEP_2_SYNC" ]; then
        history -s "jssh_step $target STEP_3_COMPLETE"
        echo -e "\033[1;33m>>> 次のノード 『jssh_step $target STEP_3_COMPLETE』 を手元に準備しました。\033[0m"
    else
        history -s "cat json_core/context_history.json"
        echo -e "\033[1;35m>>> 全工程完了！ 履歴コンテキストの全容表示コマンドを準備しました。\033[0m"
    fi
    
    echo -e "\033[1;33m>>> キーボードの 『↑』 (上矢印) を押して、次のステップへ進んでください！\033[0m"
}
# 最初の1歩目を実行（これで履歴に取り込まれます）
jssh_step CUSTOMER_001 STEP_1_INIT
