# 3. キーボードツリーナビゲーター (dag_keyboard.py) の生成と初期化
cat << 'EOF' > dag_keyboard.py
import json, sys, os, subprocess
SCHEMA_PATH = "json_core/dag_keyboard_schema.json"
STATE_PATH = "json_core/dag_keyboard_state.json"
def load_json(p):
    return json.load(open(p, "r", encoding="utf-8")) if os.path.exists(p) else {}
def save_json(p, data):
    json.dump(data, open(p, "w", encoding="utf-8"), indent=2, ensure_ascii=False)
def main():
    schema = load_json(SCHEMA_PATH)
    state = load_json(STATE_PATH)
    
    current_node_id = state.get("current_node", schema.get("root", "KEYBOARD_ROOT"))
    if len(sys.argv) > 1 and sys.argv[1] == "--reset":
        current_node_id = schema.get("root", "KEYBOARD_ROOT")
        save_json(STATE_PATH, {"current_node": current_node_id})
        print("\033[1;33m[KEYBOARD RESET] キーボードDAGツリーを ROOT ノードに初期化しました。\033[0m")
        return
    flick_input = "LEFT"
    if "--flick" in sys.argv:
        idx = sys.argv.index("--flick")
        if idx + 1 < len(sys.argv):
            flick_input = sys.argv[idx + 1].upper()
    nodes = schema.get("nodes", {})
    curr_node = nodes.get(current_node_id, {})
    print("="*65)
    print("      【 DAG MOBILE KEYBOARD TREE ENGINE 】")
    print(f"  Current Node : {current_node_id}")
    print("="*65)
    flick_map = curr_node.get("flick_map", {})
    
    if flick_input in flick_map:
        next_id = flick_map[flick_input]
        next_node = nodes.get(next_id, {})
        
        # ACTION ノードに到達した場合
        if next_node.get("type") == "ACTION":
            cmd = next_node.get("command", "")
            sug = next_node.get("next_suggest", "")
            print(f"\033[1;32m>>> [KEYBOARD TRIGGERED] Action Command: {cmd}\033[0m")
            
            # 答え側からの逆駆動：history -s にコマンドと次のキー入力予測を巻き込む
            subprocess.run(f'history -s "{cmd}"', shell=True, executable='/bin/bash')
            
            # 次の予測アクションへ自動ノード遷移して状態保存
            save_json(STATE_PATH, {"current_node": sug if sug else schema["root"]})
