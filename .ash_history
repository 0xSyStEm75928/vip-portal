      "issue_found": "Reentrancy Trigger (Line 276)",
      "is_real_environment": false,
      "reason": "実在する主要DEXの本番コントラクトではなく、名前を書き換えた検証用コード。"
    },
    {
      "target_file": "Terminal Log Output",
      "issue_found": "vSaaC Devil>>> STATUS: ACTIVE RISK DETECTED IN LOCAL REPOSITORY",
      "is_real_environment": false,
      "reason": "画像ログ自体に『LOCAL REPOSITORY（ローカル環境）』と明記されている。"
    }
  ],
  "conclusion": {
    "status": "FAKE_OR_LOCAL_ONLY",
    "action_required": "IGNORE"
  }
}
# 1. Foundryテストか確認
find . -name "*.t.sol"
# 2. デプロイスクリプトがあるか
find . -name "*.s.sol"
# 3. MetricOmmPoolFactory の実体を確認
grep -R "contract MetricOmmPoolFactory" .
# 4. Mainnet/Testnet RPC設定があるか
grep -R "rpc" . --include="*.toml" --include="*.json" --include="*.env"
# 5. デプロイアドレスが埋め込まれているか
grep -R "0x[a-fA-F0-9]\{40\}" .
# 6. forge の設定確認
git remote -v
find . -name "*.sol"
find . -name "foundry.toml" -o -name "hardhat.config.*"
find . -name "package.json"
git status
git log --oneline --decorate --graph --all -20
git branch -vv
