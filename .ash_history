# 2. 新構造に対応した sync_pipeline.py の全置換更新
cat << 'EOF' > sync_pipeline.py
import json, os, sys
from datetime import datetime, timezone
BASE_DIR = "json_core"
FILES = {
    "customer": os.path.join(BASE_DIR, "core_customer_master.json"),
    "intake": os.path.join(BASE_DIR, "ingress_customer_intake.json"),
    "gate": os.path.join(BASE_DIR, "gate_lifecycle_control.json"),
    "plan": os.path.join(BASE_DIR, "dispatch_daily_schedule.json"),
    "queue": os.path.join(BASE_DIR, "review_human_approval_queue.json"),
    "action": os.path.join(BASE_DIR, "dispatch_next_action_queue.json"),
    "sync_summary": os.path.join(BASE_DIR, "view_deal_sync_summary.json")
}
def load_j(p):
    return json.load(open(p, "r", encoding="utf-8")) if os.path.exists(p) else {}
def save_j(p, d):
    os.makedirs(os.path.dirname(p), exist_ok=True)
    json.dump(d, open(p, "w", encoding="utf-8"), indent=2, ensure_ascii=False)
def sync(target_id, status, channel="DIRECT_CONTACT"):
    ts = datetime.now(timezone.utc).isoformat()
    blocked = ["assume_purchase_intent", "assume_private_view", "deliver_before_confirmation"]
    # 1. Master
    c = load_j(FILES["customer"])
    cust_list = c.setdefault("customers", [])
    for item in cust_list:
        if item.get("customer_id") == target_id or item.get("target") == target_id:
            item.update({"updated_at": ts, "status": status, "channel": channel})
            break
    else:
        cust_list.append({"customer_id": target_id, "updated_at": ts, "status": status, "channel": channel})
    save_j(FILES["customer"], c)
    # 2. Ingress
    i = load_j(FILES["intake"])
    if "customer" in i and isinstance(i["customer"], dict):
        i["customer"].update({"customer_id": target_id, "last_contact_at": ts, "status": status, "channel": channel})
    else:
        i["customer"] = {"customer_id": target_id, "first_contact_at": ts, "last_contact_at": ts, "status": status, "channel": channel}
    save_j(FILES["intake"], i)
    # 3. Control Gate
    g = load_j(FILES["gate"])
    if "current_customer" in g and isinstance(g["current_customer"], dict):
        g["current_customer"].update({"customer_id": target_id, "updated_at": ts, "verified": status in ["VERIFIED", "CONTRACTED"], "blocked_actions": blocked})
    else:
        g["current_customer"] = {"customer_id": target_id, "updated_at": ts, "verified": status in ["VERIFIED", "CONTRACTED"], "blocked_actions": blocked}
    save_j(FILES["gate"], g)
    # 4. Schedule Plan
    p = load_j(FILES["plan"])
    acts = p.setdefault("priority", [])
    for act in acts:
        if act.get("target") == target_id or act.get("customer_id") == target_id:
            act.update({"status": status, "updated_at": ts})
            break
    else:
        acts.append({"target": target_id, "priority": "A", "objective": f"Action for {status}", "status": status, "updated_at": ts})
    save_j(FILES["plan"], p)
    # 5. Review Queue
    q = load_j(FILES["queue"])
    q_list = q.setdefault("queue", [])
    for item in q_list:
        if item.get("customer_id") == target_id or item.get("target") == target_id:
            item.update({"requires_human_approval": status != "CONTRACTED", "current_status": status, "updated_at": ts}
