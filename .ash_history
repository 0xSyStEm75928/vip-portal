# 2. フル調整版：v.old バックアップ＆リスト管理 (tools/manage_v_old.py)
cat << 'EOF' > tools/manage_v_old.py
import os, json, shutil, time, sys
from ui_decorator import Neon
BASE_DIR   = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
STATE_PATH = os.path.join(BASE_DIR, "data_store", "active_state.json")
V_OLD_DIR  = os.path.join(BASE_DIR, "data_store", "v.old")
def archive_to_v_old():
    if not os.path.exists(STATE_PATH):
        Neon.print_status("WARN", "退避対象の active_state.json が見つかりません。", Neon.YELLOW)
        return False
    os.makedirs(V_OLD_DIR, exist_ok=True)
    now_str = time.strftime("%Y%m%d_%H%M%S")
    existing_files = [f for f in os.listdir(V_OLD_DIR) if f.startswith("state_v.old")]
    gen_id = len(existing_files) + 1
    
    target_filename = f"state_v.old_{gen_id}_{now_str}.json"
    target_path = os.path.join(V_OLD_DIR, target_filename)
    
    shutil.copy(STATE_PATH, target_path)
    Neon.print_status("v.old SAVED", f"アーカイブ完了 ➔ {target_filename}", Neon.GREEN)
    return True
def list_v_old():
    print(f"\n{Neon.CYAN}═══ [v.old ARCHIVE LIST] ══════════════════════════════════════{Neon.RESET}")
    if not os.path.exists(V_OLD_DIR) or not os.listdir(V_OLD_DIR):
        print("  (保管されている v.old データはありません)")
        return
    files = sorted([f for f in os.listdir(V_OLD_DIR) if f.startswith("state_v.old")])
    for f in files:
        fpath = os.path.join(V_OLD_DIR, f)
        size = os.path.getsize(fpath)
        print(f"  ├── {Neon.MAGENTA}{f}{Neon.RESET} ({size} bytes)")
    print()
if __name__ == "__main__":
    if "--list" in sys.argv:
        list_v_old()
    else:
        archive_to_v_old()
EOF
