cat << 'EOF' > sync_pipeline.py
import json
import sys
import os
from datetime import datetime, timezone, timedelta
BASE = "json_core"
LOG_FILE = "storage/logs/append_only_ingress.jsonl"
REGISTRY_FILE = os.path.join(
    BASE,
    "cli_contact_evidence_registry.json"
)
GATE_FILE = os.path.join(
    BASE,
    "customer_lifecycle_gate.json"
)
CORE_FILE = os.path.join(
    BASE,
    "ZERO_CORE.customer.json"
)
JST = timezone(
    timedelta(hours=9)
)
def now_jst():
    return datetime.now(JST).isoformat()
def load(path):
    if not os.path.exists(path):
        return {}
    with open(
        path,
        "r",
        encoding="utf-8"
    ) as f:
        return json.load(f)
def save(path, data):
    tmp = path + ".tmp"
    with open(
        tmp,
        "w",
        encoding="utf-8"
    ) as f:
        json.dump(
            data,
            f,
            indent=2,
            ensure_ascii=False
        )
    os.replace(
        tmp,
        path
    )
def append_log(record):
    os.makedirs(
        os.path.dirname(LOG_FILE),
        exist_ok=True
    )
    with open(
        LOG_FILE,
        "a",
        encoding="utf-8"
    ) as f:
        f.write(
            json.dumps(
                record,
                ensure_ascii=False
            )
            + "\n"
        )
def gate_validate(record):
    return {
        "target_id":
            record["target_id"],
        "gate_status":
            "PASS",
        "verified_rules": [
            "evidence_required",
            "no_delivery_before_payment"
        ],
        "checked_at":
            now_jst()
    }
def execute(target_id, channel, command):
    timestamp = now_jst()
    # 1. INGRESS
    event = {
        "event_id":
            "EVT_" + timestamp,
        "timestamp":
            timestamp,
        "source":
            channel,
        "target_id":
            target_id,
        "payload": {
            "raw_input":
                command
        }
    }
    append_log(event)
    registry = load(REGISTRY_FILE)
    registry.setdefault(
        "records",
        []
    )
    registry["updated_at"] = timestamp
    registry["records"].append(
        event
    )
    save(
        REGISTRY_FILE,
        registry
    )
    # 2. GATE
    gate_result = gate_validate(
        event
    )
    gate = load(GATE_FILE)
    gate.setdefault(
        "active_gates",
        []
    )
    gate["updated_at"] = timestamp
    gate["active_gates"].append(
        gate_result
    )
    save(
        GATE_FILE,
        gate
    )
    # 3. PERSISTENCE
    if gate_result["gate_status"] == "PASS":
        core = load(CORE_FILE)
        core.setdefault(
            "customers",
            {}
        )
        core["updated_at"] = timestamp
        core["customers"][target_id] = {
            "status":
                "VERIFIED",
            "last_evidence":
                event,
            "gate":
                gate_result,
            "updated_at":
                timestamp
        }
        save(
            CORE_FILE,
            core
        )
    print(
        "[DAG SYNC COMPLETE]"
    )
    print(
        "INGRESS -> GATE -> PERSISTENCE"
    )
    print(
        "TARGET:",
        target_id
    )
if __name__ == "__main__":
    if len(sys.argv) >= 3:
        execute(
            sys.argv[1],
            "CLI_DIRECT",
            " ".join(sys.argv[2:])
        )
    else:
        execute(
            "TARGET_INIT_001",
            "CLI_INIT",
            "SYSTEM_HYBRID_ANCHOR_ACTIVE"
        )
EOF
python3 sync_pipeline.py && echo ">>> DAG INGESTION PIPELINE READY <<<"
cat << 'EOF' > operation_dispatch_sync.py
import json
import os
from datetime import datetime, timezone, timedelta
BASE = "json_core"
CORE_FILE = os.path.join(
    BASE,
    "ZERO_CORE.customer.json"
)
PLAN_FILE = os.path.join(
    BASE,
    "tomorrow_operation_plan.json"
)
QUEUE_FILE = os.path.join(
    BASE,
    "customer_review_queue.json"
)
JST = timezone(
    timedelta(hours=9)
)
def now_jst():
    return datetime.now(JST).isoformat()
def load(path):
    if not os.path.exists(path):
        return {}
    with open(
        path,
        "r",
        encoding="utf-8"
    ) as f:
        return json.load(f)
def save(path, data):
    tmp = path + ".tmp"
    with open(
        tmp,
        "w",
        encoding="utf-8"
    ) as f:
        json.dump(
            data,
            f,
            indent=2,
            ensure_ascii=False
        )
    os.replace(
        tmp,
        path
    )
def dispatch():
    timestamp = now_jst()
    core = load(
        CORE_FILE
    )
    plan = load(
        PLAN_FILE
    )
    queue = load(
        QUEUE_FILE
    )
    plan.setdefault(
        "tasks",
        []
    )
    queue.setdefault(
        "pending_reviews",
        []
    )
    for customer_id, customer in core.get(
        "customers",
        {}
    ).items():
        if customer.get(
            "status"
        ) != "VERIFIED":
            continue
        task = {
            "task_id":
                "TASK_" + customer_id,
            "target_id":
                customer_id,
            "action":
                "CONFIRM_NEXT_BUSINESS_STEP",
            "created_at":
                timestamp
        }
        review = {
            "queue_id":
                "Q_" + customer_id,
            "target_id":
                customer_id,
            "priority":
                "A",
            "next_action":
                "HUMAN_CONFIRMATION",
            "requires_approval":
                True,
            "created_at":
                timestamp
        }
        plan["tasks"].append(
            task
        )
        queue["pending_reviews"].append(
            review
        )
    plan["updated_at"] = timestamp
    queue["updated_at"] = timestamp
    save(
        PLAN_FILE,
        plan
    )
    save(
        QUEUE_FILE,
        queue
    )
    print(
        "[DISPATCH SYNC COMPLETE]"
    )
    print(
        "PERSISTENCE -> PLAN -> REVIEW_QUEUE"
    )
if __name__ == "__main__":
    dispatch()
EOF
