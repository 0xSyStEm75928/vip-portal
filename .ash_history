cat << 'EOF' > tools/manage_v_old.py
import os, json, shutil, time
STATE_PATH  = "data_store/active_state.json"
V_OLD_DIR   = "data_store/v.old"
def archive_to_v_old():
    if not os.path.exists(STATE_PATH):
        print("\033[1;33m[WARN]\033[0m 退避対象の active_state.json が存在しません。")
        return
    os.makedirs(V_OLD_DIR, exist_ok=True)
    
    # タイムスタンプと世代番号の自動付与
    now_str = time.strftime("%Y%m%d_%H%M%S")
    
    # 既存ファイルの数をカウントして世代IDを採番
    existing_files = [f for f in os.listdir(V_OLD_DIR) if f.startswith("state_v.old")]
    gen_id = len(existing_files) + 1
    
    target_filename = f"{V_OLD_DIR}/state_v.old_{gen_id}_{now_str}.json"
    
    # アクティブ状態を v.old へコピー（世代保存）
    shutil.copy(STATE_PATH, target_filename)
    print(f"\033[1;32m[v.old SAVED]\033[0m 現在の状態をアーカイブしました ➔ {target_filename}")
def list_v_old():
    print("\n\033[1;36m[v.old ARCHIVE LIST]\033[0m")
    if not os.path.exists(V_OLD_DIR) or not os.listdir(V_OLD_DIR):
        print("  (保管されている v.old データはありません)")
        return
    files = sorted(os.listdir(V_OLD_DIR))
    for f in files:
        fpath = os.path.join(V_OLD_DIR, f)
        size = os.path.getsize(fpath)
        print(f"  ├── \033[1;35m{f}\033[0m ({size} bytes)")
    print()
if __name__ == "__main__":
    import sys
    if "--list" in sys.argv:
        list_v_old()
    else:
        archive_to_v_old()
EOF
