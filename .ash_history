#!/bin/bash
# --- Lightweight JSSH Direct Core ---
TARGET="${1:-CUSTOMER_001}"
NODE="${2:-N1_INGRESS}"
if [ "$1" = "--anatomy" ]; then
    python3 anatomy_history.py
    exit 0
fi
