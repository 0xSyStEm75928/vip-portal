EOF
chmod +x ~/.local/bin/jssh
# 2. カレントシェル側で history -s を確実に注入する関数（エイリアス）化
jssh_wrapper() {
    ~/.local/bin/jssh "$@"
    # カレントシェル内で直に叩くため 100% 確実に履歴に注入され、次回 ↑ キーで即呼び出せる
    history -s "jssh ${1:-CUSTOMER_001} ${2:-N1_INGRESS}"
}
alias jssh='jssh_wrapper'
# 3. 超高速動作テスト
jssh CUSTOMER_001 N1_INGRESS
# 1. 答え側から history -s を巻き起こす JSSH コア関数の定義
jssh() {
    local target="${1:-CUSTOMER_001}"
    local node="${2:-N1_INGRESS}"
    
    # 特殊モードの判定
    if [ "$1" = "--anatomy" ]; then
        python3 anatomy_history.py
        history -s "jssh --anatomy"
        return 0
    fi
    # 1. 答え（実行結果）を出力
    echo -e "\033[1;36m=========================================================\033[0m"
    echo -e "\033[1;32m [JSSH RESPONSE ENGINE] 答えを出力中...\033[0m"
    echo -e "\033[1;36m=========================================================\033[0m"
    
    # PythonによるDAG同期ロジック呼び出し
    python3 ~/.local/bin/dag_history_trigger.py "$target" "$node"
    
    # 2. 【ここが核心】答え側が次の展開を予測し、history -s をターミナルに強烈に巻き起こす！
    local next_node="N3_GATE"
    [ "$node" = "N3_GATE" ] && next_node="N5_SUMMARY"
    [ "$node" = "N5_SUMMARY" ] && next_node="N1_INGRESS"
    
    # 次の推奨コマンドと、自前再実行コマンドを同時に履歴へインジェクション
    history -s "jq .chain_status json_core/view_deal_sync_summary.json"
    history -s "jssh $target $next_node"
    
    echo -e "\033[1;33m>>> [$-INJECTION COMPLETE] 次の展開 『jssh $target $next_node』 を history -s に巻き込みました！\033[0m"
    echo -e "\033[1;33m>>> 今すぐ 『↑』 キーを押してみてください。\033[0m"
}
# 2. シェルに即時適用して「答え側巻き起こし」をテスト
jssh CUSTOMER_001 N1_INGRESS
