cat << 'EOF' > /root/generate_security_stack.sh
#!/usr/bin/env bash
set -euo pipefail
ROOT="${1:-/root}"
CONTROLLER="$ROOT/zerocore.security.controller.json"
WORKFLOW_DIR="$ROOT/.github/workflows"
mkdir -p "$WORKFLOW_DIR"
echo "[*] ZEROCORE Security Stack Generator"
if [ ! -f "$CONTROLLER" ]; then
  echo "[!] Missing:"
  echo "$CONTROLLER"
  exit 1
fi
echo "[*] Generating Dependabot config"
mkdir -p "$ROOT/.github"
cat > "$ROOT/.github/dependabot.yml" <<'YAML'
version: 2
updates:
  - package-ecosystem: "npm"
    directory: "/"
    schedule:
      interval: "weekly"
  - package-ecosystem: "github-actions"
    directory: "/"
    schedule:
      interval: "weekly"
YAML
echo "[*] Generating CodeQL workflow"
cat > "$WORKFLOW_DIR/codeql.yml" <<'YAML'
name: ZeroCore CodeQL Security Scan
on:
  push:
  pull_request:
  schedule:
    - cron: '30 2 * * 1'
jobs:
  analyze:
    name: Analyze
    runs-on: ubuntu-latest
    permissions:
      security-events: write
      actions: read
      contents: read
    steps:
      - name: Checkout
        uses: actions/checkout@v4
      - name: Initialize CodeQL
        uses: github/codeql-action/init@v3
      - name: Analyze
        uses: github/codeql-action/analyze@v3
YAML
echo "[*] Generating Secret Scan workflow"
cat > "$WORKFLOW_DIR/secret-scan.yml" <<'YAML'
name: ZeroCore Secret Scan
on:
  push:
  pull_request:
jobs:
  scan:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Secret Scan
        uses: gitleaks/gitleaks-action@v2
YAML
echo "[*] Generating ShellCheck workflow"
cat > "$WORKFLOW_DIR/shellcheck.yml" <<'YAML'
name: ZeroCore ShellCheck
on:
  push:
  pull_request:
jobs:
  shellcheck:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: ShellCheck
        uses: ludeeus/action-shellcheck@master
YAML
echo "[*] Generating security evidence link"
jq \
--arg time "$(date -u +"%Y-%m-%dT%H:%M:%SZ")" \
'
{
  "security_stack_generation":{
    "timestamp":$time,
    "controller":"zerocore.security.controller.json",
    "generated":[
      ".github/dependabot.yml",
      ".github/workflows/codeql.yml",
      ".github/workflows/secret-scan.yml",
      ".github/workflows/shellcheck.yml"
    ],
    "status":"generated"
  }
}
' > "$ROOT/zerocore.security.stack.generated.json"
echo
echo "[✓] Security Stack Generated"
echo
find "$ROOT/.github" -type f
jq empty "$ROOT/zerocore.security.stack.generated.json"
echo "[✓] Evidence JSON valid"
EOF
chmod +x /root/generate_security_stack.sh
/root/generate_security_stack.sh /root
jq \
--arg time "$(date -u +"%Y-%m-%dT%H:%M:%SZ")" \
'
{
...
}
' > "$ROOT/zerocore.security.stack.generated.json"
find "$ROOT/.github" -type f
jq empty "$ROOT/zerocore.security.stack.generated.json"
ls -lh /root/zerocore.security.stack.generated.json
jq empty /root/zerocore.security.stack.generated.json
find "$ROOT/.github" -maxdepth 3 -type f
jq \
