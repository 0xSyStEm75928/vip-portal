{
 test_suite_version:"1.0.0",
 generated_at:$t,
 suites:[
  "schema",
  "runtime",
  "authority",
  "security",
  "recovery",
  "release"
 ],
 status:"READY"
}
' > "$TEST"
# -----------------------------------------------------
