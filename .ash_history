# 1. 未知数ロジック × キーボード連打 統合エンジンの作成
cat << 'EOF' > kbd_x_belphegor_engine.py
import json, sys, os, time, math, random
STATE_PATH = "json_core/kbd_x_belphegor_state.json"
def load_state():
    if os.path.exists(STATE_PATH):
        try: return json.load(open(STATE_PATH, "r", encoding="utf-8"))
        except: pass
    return {
        "cycle": 0,
        "unk_x": 0.50, # 未知数 x の初期値
        "last_ts": time.time(),
        "status": "X_INIT"
    }
def main():
    state = load_state()
    cycle = state.get("cycle", 0) + 1
    
    # 1. 打鍵間隔 (delta_ms) の計測
    now = time.time()
    last_ts = state.get("last_ts", now)
    delta_ms = max(10, int((now - last_ts) * 1000)) # ゼロ割防止
    state["last_ts"] = now
    # 2. 【未知数 x の注入 & 変動】
    # 過去の未知数 x にランダムな未知の揺らぎ (±0.15) を付与
    prev_x = state.get("unk_x", 0.50)
    unk_x = round(min(0.99, max(0.01, prev_x + random.uniform(-0.15, 0.15))), 4)
    # 3. ★★★【掛け算ロジック】 (打鍵スピード × 未知数 x) ★★★
    # 打鍵が速い（delta_msが小さい）ほど speed_factor が大きくなる
    speed_factor = round(1000.0 / delta_ms, 2)
    
    # 未知数 x と 打鍵速度 の積（乗算）
    multiplied_impact = round(speed_factor * unk_x, 4)
    # 4. AIの確信度/到達度 P を Sigmoid で算出
    sigmoid_p = round(1.0 / (1.0 + math.exp(-0.5 * (multiplied_impact - 2.0))), 4)
    # 5. 結果に応じたAIモードの自動変化
    if sigmoid_p >= 0.85:
        ai_mode = "OVERDRIVE_AWAKENED"
        node_label = "N_X_OVERDRIVE"
    elif sigmoid_p >= 0.50:
        ai_mode = "STABLE_INFERENCE"
        node_label = "N_X_STABLE"
    else:
        ai_mode = "CHAOS_SEARCHING"
        node_label = "N_X_CHAOS"
    state.update({
        "cycle": cycle,
        "delta_ms": delta_ms,
        "unk_x": unk_x,
        "multiplied_impact": multiplied_impact,
        "sigmoid_p": sigmoid_p,
        "ai_mode": ai_mode,
        "node_label": node_label,
        "status": "X_CALCULATED"
    })
    os.makedirs("json_core", exist_ok=True)
    json.dump(state, open(STATE_PATH, "w", encoding="utf-8"), indent=2, ensure_ascii=False)
    # 親シェルへの応答
    next_cmd = f"x_stream '{node_label}'"
    print(f"SUCCESS|{node_label}|{unk_x}|{multiplied_impact}|{sigmoid_p}|{ai_mode}|{delta_ms}|{next_cmd}")
if __name__ == "__main__":
    main()
EOF
# 2. 親シェル関数の定義 (x_stream)
x_stream() {
    local label="${1:-N_X_START}"
    local res=$(python3 kbd_x_belphegor_engine.py "$label" 2>&1)
    if echo "$res" | grep -q "^SUCCESS"; then
        local node=$(echo "$res" | cut -d'|' -f2)
        local unk_x=$(echo "$res" | cut -d'|' -f3)
        local impact=$(echo "$res" | cut -d'|' -f4)
        local prob=$(echo "$res" | cut -d'|' -f5)
        local mode=$(echo "$res" | cut -d'|' -f6)
        local delta=$(echo "$res" | cut -d'|' -f7)
        local next_cmd=$(echo "$res" | cut -d'|' -f8)
        echo -e "\033[1;35m[AI UNKNOWN x ENGINE]\033[0m Delta: ${delta}ms | \033[1;33m未知数x: $unk_x\033[0m | \033[1;32m積: $impact\033[0m ➔ P: $prob (\033[1;36m$mode\033[0m)"
        # 履歴インジェクション (マルチライン装填)
        history -s "$next_cmd"
        history -s "cat json_core/kbd_x_belphegor_state.json"
        
        echo -e "\033[1;33m>>> 未知数掛け算ストリーム『x_stream』を history -s に注入！『↑』キーを押してください。\033[0m"
    else
        echo "ERROR: $res"
    fi
}
# 起動テスト
x_stream
# 1. 抑制型未知数 × リアル・オーバーライド エンジンの再構築
cat << 'EOF' > kbd_x_belphegor_engine.py
import json, sys, os, time, math, random
STATE_PATH = "json_core/kbd_x_belphegor_state.json"
def load_state():
    if os.path.exists(STATE_PATH):
        try: return json.load(open(STATE_PATH, "r", encoding="utf-8"))
        except: pass
    return {
        "cycle": 0,
        "unk_x": 0.10, # 未知数を極限まで抑制
        "last_ts": time.time(),
        "status": "X_MASKED"
    }
def main():
    state = load_state()
    cycle = state.get("cycle", 0) + 1
    
    # 引数からオーバーライドの有無を取得
    arg_cmd = sys.argv[1] if len(sys.argv) > 1 else "NORMAL"
    is_override = (arg_cmd == "OVERRIDE")
    # 1. 時間軸 (delta_ms) の計測
    now = time.time()
    last_ts = state.get("last_ts", now)
    delta_ms = max(10, int((now - last_ts) * 1000))
    state["last_ts"] = now
    # 2. 未知数 x の密やかな変動（0.01 ~ 0.30 の狭い範囲で抑制）
    prev_x = state.get("unk_x", 0.10)
    unk_x = round(min(0.30, max(0.01, prev_x + random.uniform(-0.02, 0.02))), 4)
    # 3. リアル・オーバーライド判定
    if is_override:
        # ★★★ リアル・オーバーライド発動 ★★★
        sigmoid_p = 1.0000
        ai_mode = "FORCE_OVERRIDDEN"
        node_label = "N_REAL_OVERRIDE"
        unk_x = 0.9999 # オーバーライド時のみ未知数が最大解読される
        impact = 999.99
    else:
        # 4. 通常時：重厚な抑制計算（よっぽどの超絶打鍵＋高確率でないと捲れない）
        speed_factor = round(1000.0 / delta_ms, 2)
        impact = round(speed_factor * unk_x, 4)
        
        # 閾値を非常に厳しく設定
        sigmoid_p = round(1.0 / (1.0 + math.exp(-0.1 * (impact - 15.0))), 4)
        if delta_ms < 150 and unk_x > 0.25 and sigmoid_p > 0.80:
            ai_mode = "RARE_UNMASKED" # 万に一つのめくれ
            node_label = "N_UNMASKED"
        else:
            ai_mode = "MASKED_STABLE" # 通常はガッチリ覆い隠される
            node_label = "N_MASKED"
    state.update({
        "cycle": cycle,
        "delta_ms": delta_ms,
        "unk_x": unk_x,
        "multiplied_impact": impact,
        "sigmoid_p": sigmoid_p,
        "ai_mode": ai_mode,
        "node_label": node_label,
        "status": "X_RESTRICTED"
    })
    os.makedirs("json_core", exist_ok=True)
    json.dump(state, open(STATE_PATH, "w", encoding="utf-8"), indent=2, ensure_ascii=False)
    # 親シェルへの応答（通常用コマンドと、オーバーライド用の引き込み）
    next_cmd = f"x_stream '{node_label}'"
    print(f"SUCCESS|{node_label}|{unk_x}|{impact}|{sigmoid_p}|{ai_mode}|{delta_ms}|{next_cmd}")
if __name__ == "__main__":
    main()
EOF
# 2. 親シェル関数の更新 (オーバーライドコマンド追加)
x_stream() {
    local label="${1:-NORMAL}"
    local res=$(python3 kbd_x_belphegor_engine.py "$label" 2>&1)
    if echo "$res" | grep -q "^SUCCESS"; then
        local node=$(echo "$res" | cut -d'|' -f2)
        local unk_x=$(echo "$res" | cut -d'|' -f3)
        local impact=$(echo "$res" | cut -d'|' -f4)
        local prob=$(echo "$res" | cut -d'|' -f5)
        local mode=$(echo "$res" | cut -d'|' -f6)
        local delta=$(echo "$res" | cut -d'|' -f7)
        local next_cmd=$(echo "$res" | cut -d'|' -f8)
        if [ "$mode" = "FORCE_OVERRIDDEN" ]; then
            echo -e "\033[1;31m[!!! REAL OVERRIDE ACTIVATED !!!]\033[0m \033[1;33m全制御を強制上書きしました！\033[0m P: $prob"
        elif [ "$mode" = "RARE_UNMASKED" ]; then
            echo -e "\033[1;35m[★ RARE UNMASKED! ★]\033[0m 未知数の壁を自力突破！ Delta: ${delta}ms | 未知数x: $unk_x"
        else
            echo -e "\033[1;34m[X-RESTRICTED]\033[0m Delta: ${delta}ms | \033[0;36m未知数x: [隠蔽/抑制中 $unk_x]\033[0m ➔ P: $prob (\033[1;30m$mode\033[0m)"
        fi
        # 次の一手を装填
        history -s "$next_cmd"
# 1. シェルキャッシュを即座にリセット（迷子解消）
hash -r
# 2. ログ確認と動作実行を完全に1回に束ねた同期型ラッパー
x_sync() {
    local cmd="${1:-NORMAL}"
    
    # エンジン実行
    python3 kbd_x_belphegor_engine.py "$cmd" > /dev/null 2>&1
    
    # 実行された瞬間の【ナマのログ（JSON）】をその場で即座に読み出して描画！
    if [ -f "json_core/kbd_x_belphegor_state.json" ]; then
        echo -e "\033[1;35m=========================================================\033[0m"
        echo -e "\033[1;33m[BELPHEGOR LIVE LOG]\033[0m \033[1;32m$(date +%H:%M:%S)\033[0m"
        cat json_core/kbd_x_belphegor_state.json
        echo -e "\033[1;35m=========================================================\033[0m"
    else
        echo -e "\033[1;31m[LOG WAIT]\033[0m まだログが生成されていません。"
    fi
    # history -s に次の一手をセット
    history -s "x_sync OVERRIDE"
    history -s "x_sync"
    
    echo -e "\033[1;32m>>> 『↑』キーで連打するか、オーバーライドなら『x_sync OVERRIDE』！\033[0m"
}
