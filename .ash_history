python3 -c '
import re, json
path = "json_core/cli_contact_evidence_registry.json"
with open(path, "r", encoding="utf-8") as f:
    text = f.read()
# 1. 前の行末へのカンマ補完
text = re.sub(r"([^\,\{\[\s])\s*\n(\s*)\"?contact_channel\"?", r"\1,\n\2\"contact_channel\"", text)
# 2. キーと値の間のコロン (:) 補完・崩れ修復
text = re.sub(r"\"contact_channel\"\s*([^:\s])", r"\"contact_channel\": \1", text)
# 3. 値をクォーテーションで囲む補完（必要な場合）
text = re.sub(r"\"contact_channel\"\s*:\s*([a-zA-Z0-9_]+)(\s*[,}\n])", r"\"contact_channel\": \"\1\"\2", text)
data = json.loads(text)
with open(path, "w", encoding="utf-8") as f:
    json.dump(data, f, indent=2, ensure_ascii=False)
