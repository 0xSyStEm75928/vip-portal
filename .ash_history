jq empty saac.master.registry.json && echo "MASTER REGISTRY OK"
cat <<'EOF' > saac.registry.inspect.sh
#!/bin/sh
REGISTRY="saac.master.registry.json"
jq -r '
.modules
| to_entries[]
| "\n[" + .key + "]"
+ "\n"
+ (.value[] | " - " + .)
' "$REGISTRY"
