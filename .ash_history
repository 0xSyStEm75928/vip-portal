cat <<'EOF' > saac.service.catalog.json
{
  "$schema": "./schemas/saac.service.catalog.schema.json",
  "name": "SaaC Service Catalog",
  "version": "1.0.0",
  "purpose": "Define commercial service offerings powered by evidence driven CUI operations",
  "catalog": {
    "provider": {
      "name": "SaaC DeviL / ZeroCore",
      "interface": "CUI_FIRST",
      "delivery_mode": "evidence_based"
    },
    "services": [
      {
        "id": "technical_review",
        "name": "Technical Architecture Review",
        "description": "Evidence based review of software architecture, configuration and technical issues",
        "input": [
          "repository",
          "configuration",
          "issue_context"
        ],
        "process": [
          "collect",
          "observe",
          "validate",
          "analyze"
        ],
        "output": [
          "review_report",
          "evidence_record",
          "recommendation"
        ],
        "evidence_required": true,
        "status": "available"
      },
      {
        "id": "cli_automation",
        "name": "CLI Automation Support",
        "description": "Design and improvement of command line workflows and automation pipelines",
        "input": [
          "workflow_definition",
          "manual_operation",
          "environment_information"
        ],
        "process": [
          "workflow_analysis",
          "automation_design",
          "validation"
        ],
        "output": [
          "automation_plan",
          "script_definition",
          "execution_record"
        ],
        "evidence_required": true,
        "status": "available"
      },
      {
        "id": "evidence_analysis",
        "name": "Evidence Intelligence Analysis",
        "description": "Transform logs, records and technical signals into structured evidence",
        "input": [
          "logs",
          "events",
          "documents"
        ],
        "process": [
          "normalize",
          "classify",
          "score"
        ],
        "output": [
          "evidence_package",
          "analysis_result",
          "confidence_score"
        ],
        "evidence_required": true,
        "status": "available"
      }
    ]
  },
  "commercial_policy": {
    "pricing": {
      "mode": "external_negotiation",
      "automatic_quote": false
    },
    "requirements": [
      "scope_confirmation",
      "client_agreement",
      "delivery_definition"
    ]
  },
  "response_contract": {
    "format": "SaaC_RESPONSE",
    "linked_schema": "saac.response.schema.json"
  },
  "governance": {
    "rules": [
      "no_guaranteed_result",
      "evidence_before_claim",
      "transparent_scope"
    ]
  },
  "state": {
    "status": "service_definition_ready"
  }
}
EOF
cat <<'EOF' > saac.delivery.package.json
{
  "$schema": "./schemas/saac.delivery.package.schema.json",
