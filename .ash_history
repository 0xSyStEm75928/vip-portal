cat << 'EOF' > sync_pipeline.py
import json, os, sys
from datetime import datetime, timezone
BASE_DIR = "json_core"
FILES = {
    "customer": os.path.join(BASE_DIR, "ZERO_CORE.customer.json"),
    "intake": os.path.join(BASE_DIR, "customer_intake.json"),
    "gate": os.path.join(BASE_DIR, "customer_lifecycle_gate.json"),
    "plan": os.path.join(BASE_DIR, "tomorrow_operation_plan.json"),
    "queue": os.path.join(BASE_DIR, "customer_review_queue.json")
}
def load_j(path):
    if os.path.exists(path):
        with open(path, "r", encoding="utf-8") as f:
            return json.load(f)
    return {}
def save_j(path, data):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w", encoding="utf-8") as f:
        json.dump(
            data,
            f,
            indent=2,
            ensure_ascii=False
        )
def sync(target_id, status, channel="DIRECT_CONTACT"):
    ts = datetime.now(timezone.utc).isoformat()
    blocked = [
        "assume_purchase_intent",
        "assume_private_view",
        "deliver_before_confirmation"
    ]
    # ZERO_CORE.customer.json
    c = load_j(FILES["customer"])
    customers = c.setdefault("customers", [])
    found = False
    for item in customers:
        if item.get("customer_id") == target_id:
            item.update({
                "updated_at": ts,
                "status": status,
                "channel": channel
            })
            found = True
            break
    if not found:
        customers.append({
            "customer_id": target_id,
            "updated_at": ts,
            "status": status,
            "channel": channel
        })
    save_j(FILES["customer"], c)
    # customer_intake.json
    i = load_j(FILES["intake"])
    if isinstance(i.get("customer"), dict):
        i["customer"].update({
            "customer_id": target_id,
            "last_contact_at": ts,
            "status": status,
            "channel": channel
        })
    else:
        i["customer"] = {
            "customer_id": target_id,
            "first_contact_at": ts,
            "last_contact_at": ts,
            "status": status,
            "channel": channel
        }
    save_j(FILES["intake"], i)
    # customer_lifecycle_gate.json
    g = load_j(FILES["gate"])
    g["current_customer"] = {
        "customer_id": target_id,
        "updated_at": ts,
        "verified": status in [
            "VERIFIED",
            "CONTRACTED"
        ],
        "blocked_actions": blocked
    }
    save_j(FILES["gate"], g)
    # tomorrow_operation_plan.json
    p = load_j(FILES["plan"])
    priority = p.setdefault("priority", [])
    priority.append({
        "target": target_id,
        "priority": "A",
        "objective": f"Action for {status}",
        "status": status,
        "updated_at": ts
    })
    save_j(FILES["plan"], p)
    # customer_review_queue.json
    q = load_j(FILES["queue"])
    queue = q.setdefault("queue", [])
    queue.append({
        "target_id": target_id,
        "requires_human_approval": status != "CONTRACTED",
        "current_status": status,
        "updated_at": ts
    })
    save_j(FILES["queue"], q)
    print(
        f"[OK] ALL JSON SYNC COMPLETE: {target_id} ({status})"
    )
if __name__ == "__main__":
    if len(sys.argv) < 3:
        print(
            "Usage: python3 sync_pipeline.py <TARGET_ID> <STATUS> [CHANNEL]"
        )
        sys.exit(1)
    sync(
        sys.argv[1],
        sys.argv[2],
        sys.argv[3] if len(sys.argv) > 3 else "DIRECT"
    )
EOF
