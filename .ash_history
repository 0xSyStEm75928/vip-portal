#!/bin/sh
BASE="business_opportunity.registry.json"
PATCH="business_opportunity.pipeline.fragment.json"
OUT="business_opportunity.registry.final.json"
jq -s '
.[0] * .[1]
' "$BASE" "$PATCH" > "$OUT"
echo "generated: $OUT"
EOF
