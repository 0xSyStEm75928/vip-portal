    echo -e "\033[1;36m=========================================================\033[0m"
    
    # 実際の一括同期処理を実行
    python3 ~/.local/bin/dag_history_trigger.py CUSTOMER_001 N1_INGRESS
    
    # 【答え側からの逆駆動】親シェルの入力履歴（history -s）へ次の一手を直接送り込む！
    history -s "jq .chain_status json_core/view_deal_sync_summary.json"
