      "urgency": 10
    }
  },
  "print_output_guard": {
    "enabled": true,
    "rules": [
      "observation_only",
      "no_unverified_claim",
      "require_source",
      "require_reason"
    ]
  },
  "jssh_integration": {
    "mode": "history_stream",
    "event_type": "command_observation",
    "event_template": {
      "id": null,
      "timestamp": null,
      "command": null,
      "result_hash": null,
      "validated": false
