# 1. 自動復元（ロールバック）エンジンの作成
cat << 'EOF' > tools/restore_v_old.py
import os, json, shutil, sys
V_OLD_DIR   = "data_store/v.old"
STATE_PATH  = "data_store/active_state.json"
def restore_from_v_old(target_file=None):
    if not os.path.exists(V_OLD_DIR) or not os.listdir(V_OLD_DIR):
        print("\033[1;31m[FAIL]\033[0m 復元可能な v.old データが存在しません。")
        return False
    files = sorted([f for f in os.listdir(V_OLD_DIR) if f.startswith("state_v.old")])
    if not files:
        print("\033[1;31m[FAIL]\033[0m 有効な v.old ファイルが見つかりません。")
        return False
    # Targetが指定されていない場合は最新の v.old を自動選択
    if not target_file:
        selected_file = files[-1]
    else:
        selected_file = target_file if target_file in files else None
        if not selected_file:
            print(f"\033[1;31m[FAIL]\033[0m 指定されたファイル '{target_file}' が見つかりません。")
            return False
    src_path = os.path.join(V_OLD_DIR, selected_file)
    shutil.copy(src_path, STATE_PATH)
    print(f"\033[1;32m[ROLLBACK SUCCESS]\033[0m '{selected_file}' ➔ '{STATE_PATH}' へ完全復元完了！")
    return True
if __name__ == "__main__":
    target = sys.argv[1] if len(sys.argv) > 1 else None
    restore_from_v_old(target)
EOF
