# Room m25 の Discord Webhook URL（あなたのルームのURLに書き換えてください）
M25_WEBHOOK_URL = os.environ.get("M25_WEBHOOK_URL", "https://discord.com/api/webhooks/YOUR_M25_TOKEN")
# 監視ログの保存先（iSH内のパス）
OLD_LOG = "/tmp/m25_target_old.txt"
NEW_LOG = "/tmp/m25_target_new.txt"
# ==============================================================================
# FUNCTIONS
# ==============================================================================
def send_ping_to_m25(diff_output):
    """Room m25へ隠密に差分（違反検知）データを送信する"""
    payload = {
        "username": "M25_Diff_Hunter",
        "avatar_url": "https://i.imgur.com/83uA6pM.png",
        "content": f"🚨 **[Room m25 - 違反・差分検知]**\nターゲットに不審な変更（diff）を確認しました。\n```diff\n{diff_output}\n```"
    }
    
    headers = {"Content-Type": "application/json"}
    try:
        response = requests.post(M25_WEBHOOK_URL, data=json.dumps(payload), headers=headers)
        if response.status_code in [200, 204]:
            print("[+] Room m25 への通知成功。")
        else:
            print(f"[-] Webhookエラー: {response.status_code}")
    except Exception as e:
        print(f"[-] 送信失敗: {e}")
def check_diff_and_hunt():
    """新旧のログを比較し、差分があれば通知する"""
    # 初回実行時（古いログがない場合）は比較スキップ
    if not os.path.exists(OLD_LOG):
        if os.path.exists(NEW_LOG):
            os.rename(NEW_LOG, OLD_LOG)
        print("[*] 初回データ作成完了。監視を開始します...")
        return
    # ファイルの読み込み
    with open(OLD_LOG, 'r', encoding='utf-8') as f:
        old_lines = f.readlines()
    with open(NEW_LOG, 'r', encoding='utf-8') as f:
        new_lines = f.readlines()
    # diff（差分）の計算
    diff = list(difflib.unified_diff(
        old_lines, new_lines, 
        fromfile='前回ログ', tofile='最新ログ', 
        lineterm=''
    ))
    if diff:
        # 差分（違反行為や更新）があった場合
        diff_text = "\n".join(diff[:30]) # Discordの文字制限対策で最初の30行のみ
        print("[!] 差分を検知！ Room m25 へ送信します。")
        send_ping_to_m25(diff_text)
        
        # 次回監視のためにログを更新
        os.rename(NEW_LOG, OLD_LOG)
    else:
        print("[*] 差分なし。ターゲットに異常行動はありません。")
        if os.path.exists(NEW_LOG):
            os.remove(NEW_LOG)
