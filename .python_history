import json
import pickle
import base64
class JsonPicl:
    """Level 1: Basic Hybrid Serializer (JSON + Pickle)"""
    
    @staticmethod
    def encode(obj, json_meta=None) -> str:
        """Pythonオブジェクトを Pickle化 して Base64化 し、JSONラッパーに包む"""
        raw_pickle = pickle.dumps(obj)
        b64_pickle = base64.b64encode(raw_pickle).decode('utf-8')
        
        container = {
            "status": "ok",
            "meta": json_meta or {},
            "python_type": type(obj).__name__,
            "pickle_b64": b64_pickle
        }
        return json.dumps(container, ensure_ascii=False, indent=2)
    @staticmethod
    def decode(json_str: str):
        """JSONラッパーを解体して、中のPickleオブジェクトを復元する"""
        container = json.loads(json_str)
        b64_pickle = container["pickle_b64"]
        raw_pickle = base64.b64decode(b64_pickle.encode('utf-8'))
        return pickle.loads(raw_pickle)
