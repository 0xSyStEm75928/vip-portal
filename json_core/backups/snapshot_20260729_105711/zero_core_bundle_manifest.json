{
  "$schema": "./schemas/zero.core.bundle.schema.json",

  "bundle": {
    "name": "ZERO_CORE_BUSINESS_BUNDLE",
    "version": "1.0.0",
    "purpose": "Unified dependency manifest for all JSON domains",
    "mode": "DAG_RECONSTRUCTABLE"
  },

  "principles": {
    "single_source_of_truth": true,
    "modules_are_reversible": true,
    "no_hidden_state_assumption": true,
    "human_confirmation_required": true
  },

  "domains": {

    "PERSONAL": {
      "role": "private_project_layer",
      "nodes": [
        "ZERO_CORE.customer.json",
        "customer_intake.json",
        "customer_lifecycle_gate.json"
      ]
    },

    "BUSINESS": {
      "role": "customer_deal_pipeline",
      "nodes": [
        "customer_real_deal_review.json",
        "customer_deal_sync_result.json",
        "customer_deal_action_plan.json",
        "customer_execution_gate_check.json",
        "customer_final_business_dashboard.json"
      ]
    },

    "DISCOVERY": {
      "role": "external_public_candidate_layer",
      "nodes": [
        "cli_target_discovery.json",
        "cli_business_candidate_review.json",
        "cli_business_signal_deep_review.json",
        "original_10_target_audit.json",
        "original_10_target_priority.json"
      ]
    },

    "CONTROL": {
      "role": "execution_and_integrity",
      "nodes": [
        "merged_business_view.json",
        "business_portfolio_status.json",
        "business_execution_queue.json",
        "today_business_focus.json",
        "business_integrity_report.json",
        "business_master_index.json",
        "business_pipeline_summary.json",
        "business_final_report.json",
        "business_release_check.json"
      ]
    }

  },

  "dag": {

    "root": "ZERO_CORE_BUSINESS_BUNDLE",

    "edges": [

      {
        "from": "PERSONAL",
        "to": "BUSINESS",
        "relation": "feeds"
      },

      {
        "from": "DISCOVERY",
        "to": "BUSINESS",
        "relation": "candidate_input"
      },

      {
        "from": "BUSINESS",
        "to": "CONTROL",
        "relation": "validated_execution"
      }

    ]
  },


  "runtime": {

    "build_order": [
      "PERSONAL",
      "DISCOVERY",
      "BUSINESS",
      "CONTROL"
    ],

    "rebuild_supported": true,

    "mutation_policy": "NODE_LEVEL_ONLY"
  }
}
