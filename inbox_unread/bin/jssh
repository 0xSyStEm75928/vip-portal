#!/bin/bash
# --- Lightweight JSSH Direct Core ---
TARGET="${1:-CUSTOMER_001}"
NODE="${2:-N1_INGRESS}"

if [ "$1" = "--anatomy" ]; then
    python3 anatomy_history.py
    exit 0
fi

if [ "$1" = "--dag-status" ]; then
    python3 ~/.local/bin/dag_history_trigger.py "$TARGET" N5_SUMMARY
    exit 0
fi

echo -e "\033[1;36m[JSSH INSTANT PULSE]\033[0m Target: \033[1;32m$TARGET\033[0m | Node: \033[1;33m$NODE\033[0m"

# Python環境へ直結実行（ノー遅延）
python3 ~/.local/bin/dag_history_trigger.py "$TARGET" "$NODE"
